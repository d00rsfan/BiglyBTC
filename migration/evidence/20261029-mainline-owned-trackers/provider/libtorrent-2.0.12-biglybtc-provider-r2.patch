+      auto wrong=query(i);wrong.local.port=wrong.local.port==65535?1:std::uint16_t(wrong.local.port+1);
+      TEST_EQUAL(tracker->biglybtc_routing_query(wrong).result,std::uint32_t(BiglybtcMainlineRoutingResultV1::NoSocket));
