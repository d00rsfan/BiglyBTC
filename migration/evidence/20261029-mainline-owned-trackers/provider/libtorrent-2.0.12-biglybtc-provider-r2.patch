+// Optional exact-source/artifact-bound LT2.0.12 observation ABI. A marker or
+// installed header alone never grants runtime authority. Existing ABIs unchanged.
+#ifndef TORRENT_BIGLYBTC_QUEUE_OBSERVER_HPP
+#define TORRENT_BIGLYBTC_QUEUE_OBSERVER_HPP
+#include "libtorrent/config.hpp"
+#include "libtorrent/fwd.hpp"
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <type_traits>
+#define TORRENT_BIGLYBTC_QUEUE_OBSERVER_ABI 1
+namespace libtorrent {
+enum class BiglybtcQueueEventKindV1 : std::uint32_t {
+    StartedDownload=1, StartedSeed=2, Finished=3, Unfinished=4, Stopped=5,
+    Scrape=6, Announce=7, ScrapeFailed=8, AnnounceFailed=9, Lost=10
+};
+struct BiglybtcQueueEventV1 {
+    std::uint64_t sequence;
+    std::uint64_t request;
+    std::int64_t observed_nanoseconds;
+    std::int64_t request_started_nanoseconds;
+    std::int64_t observed_wall_milliseconds;
+    std::int64_t request_started_wall_milliseconds;
+    std::int32_t seeds;
+    std::int32_t peers;
+    std::uint32_t kind;
+    std::uint32_t protocol; //1=V1,2=V2;0 only lifecycle/loss
+    std::array<unsigned char,32> tracker_sha256; //Exact URL bytes; never credentials
+};
+static_assert(sizeof(BiglybtcQueueEventV1)==96,"Queue event ABI size");
+static_assert(std::is_standard_layout<BiglybtcQueueEventV1>::value
+    &&std::is_trivially_copyable<BiglybtcQueueEventV1>::value,"Queue event POD");
+// Each bound torrent owns its sink until real destruction. Observations run
+// only on its actual io_context thread; sink must not block, throw or call LT.
+// No polling, IO, extra status, timer, count synthesis or private pointer export.
+struct BiglybtcQueueObserverV1 {
+    virtual ~BiglybtcQueueObserverV1()=default;
+    virtual void observe(BiglybtcQueueEventV1 const&) noexcept=0;
+};
+enum class BiglybtcQueueObserverStatusV1 : std::uint32_t {
+    Accepted=0, InvalidArgument=1, InvalidHandle=2, WrongThread=3, AlreadyBound=4, Failed=5
+};
+extern "C" TORRENT_EXPORT unsigned biglybtc_queue_observer_abi_v1() noexcept;
+// Shared C++ sink/weak-handle ABI is versioned with this reviewed toolchain.
+// Attach once in the existing extension factory before activation. Output-free;
+// failure never replaces another sink. The sink retains the same qualified DSO.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_attach_queue_observer_v1(
+    torrent_handle const*,std::shared_ptr<BiglybtcQueueObserverV1> const*) noexcept;
+}
+#endif
