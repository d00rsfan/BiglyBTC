+        },settings,counters,*storage,dht::dht_state{},identity);
+    tracker->new_socket(h4);TEST_CHECK(!identity->ready());tracker->new_socket(h6);TEST_CHECK(identity->ready());
+    TEST_EQUAL(identity->status.adopted,2U);TEST_EQUAL(identity->status.active_mask,3U);
+    std::uint64_t cookie=0;
+    auto query=[&](unsigned index,unsigned mode=1){BiglybtcMainlineRoutingQueryV1 q{};q.version=1;q.size=sizeof(q);
+      q.generation=requested.generation;q.cookie=++cookie;q.mode=mode;q.local=requested.bindings[index];return q;};
+    for(unsigned i=0;i<2;++i){auto empty=tracker->biglybtc_routing_query(query(i));
+      TEST_EQUAL(empty.result,0U);TEST_EQUAL(empty.count,0U);TEST_EQUAL(empty.local.family,i==0?4U:6U);TEST_CHECK(empty.local.key==requested.bindings[i].key);}
+    for(unsigned i=0;i<2;++i){
