+using namespace lt;
+namespace {
+std::string encoded(entry const& value){std::string out;bencode(std::back_inserter(out),value);return out;}
+tracker_response parsed(entry const& value,bool scrape=false){
+    auto const text=encoded(value);error_code ec;
+    auto result=parse_tracker_response(span<char const>(text.data(),text.size()),ec,
+        scrape?tracker_request::scrape_request:tracker_request_flags_t{},sha1_hash("aaaaaaaaaaaaaaaaaaaa"));
+    TEST_CHECK(!ec);return result;
+}
+}
+TORRENT_TEST(original_tracker_fields_preserve_presence_raw_longs_and_extensions)
+{
+    entry announce;announce["interval"]=1800;announce["peers"]="";
+    auto a=parsed(announce);TEST_CHECK(a.biglybtc_response_fields.meaning==BiglybtcTrackerResponseMeaningV1::OriginalHttpFields);
+    TEST_EQUAL(a.biglybtc_response_fields.present,0u);
+    announce["complete"]=std::int64_t{4294967296};announce["extensions"]["incomplete"]=7;
+    auto b=parsed(announce);TEST_EQUAL(b.biglybtc_response_fields.present,3u);
+    TEST_EQUAL(b.biglybtc_response_fields.complete,std::int64_t{4294967296});TEST_EQUAL(b.biglybtc_response_fields.incomplete,7);
+    announce["downloaded"]=-2;auto c=parsed(announce);TEST_EQUAL(c.biglybtc_response_fields.present,7u);TEST_EQUAL(c.biglybtc_response_fields.downloaded,-2);
+}
+TORRENT_TEST(original_scrape_fields_distinguish_absence_invalid_downloaded_and_wrong_types)
+{
+    entry scrape;scrape["files"]["aaaaaaaaaaaaaaaaaaaa"]["complete"]=3;
+    auto a=parsed(scrape,true);TEST_CHECK(a.biglybtc_response_fields.meaning==BiglybtcTrackerResponseMeaningV1::OriginalHttpFields);TEST_EQUAL(a.biglybtc_response_fields.present,1u);
+    scrape["files"]["aaaaaaaaaaaaaaaaaaaa"]["downloaded"]=-2;auto b=parsed(scrape,true);TEST_EQUAL(b.biglybtc_response_fields.present,5u);TEST_EQUAL(b.biglybtc_response_fields.downloaded,-2);
+    scrape["files"]["aaaaaaaaaaaaaaaaaaaa"]["incomplete"]="bad";auto c=parsed(scrape,true);TEST_CHECK(c.biglybtc_response_fields.meaning==BiglybtcTrackerResponseMeaningV1::Unknown);
+}
+TORRENT_TEST(original_tracker_unknown_shapes_cannot_be_initial_error_authority)
+{
+    entry announce;announce["interval"]=1800;announce["peers"]="";announce["unknown-extension"]=7;
+    TEST_CHECK(parsed(announce).biglybtc_response_fields.meaning==BiglybtcTrackerResponseMeaningV1::Unknown);
+    announce.dict().erase("unknown-extension");announce["peers"]="x";
+    TEST_CHECK(parsed(announce).biglybtc_response_fields.meaning==BiglybtcTrackerResponseMeaningV1::Unknown);
+    announce["peers"]="";announce["extensions"]["complete"]="bad";
+    TEST_CHECK(parsed(announce).biglybtc_response_fields.meaning==BiglybtcTrackerResponseMeaningV1::Unknown);
+}
