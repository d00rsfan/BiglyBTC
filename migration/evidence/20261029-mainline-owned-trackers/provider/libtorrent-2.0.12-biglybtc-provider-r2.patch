+	void torrent::biglybtc_tracker_response_event(BiglybtcTrackerResponseKindV1 kind,
+		tracker_request const& req,BiglybtcTrackerResponseFieldsV1 fields) noexcept
+	{
+		if(!m_biglybtc_response_observer||m_biglybtc_response_lost) return;
+		if(m_biglybtc_response_sequence==(std::numeric_limits<std::uint64_t>::max)()) kind=BiglybtcTrackerResponseKindV1::Lost;
+		BiglybtcTrackerResponseEventV1 event{};event.admission=m_biglybtc_response_admission;event.sequence=m_biglybtc_response_sequence;
+		if(kind!=BiglybtcTrackerResponseKindV1::Lost) event.sequence=++m_biglybtc_response_sequence;
+		event.request=req.biglybtc_queue_request;event.request_started_nanoseconds=req.biglybtc_queue_started_nanoseconds;
+		event.request_started_wall_milliseconds=req.biglybtc_queue_started_wall_milliseconds;
+		event.observed_nanoseconds=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+		event.observed_wall_milliseconds=std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+		if(m_wire_info_hash.has_v1()&&req.info_hash==m_wire_info_hash.v1) event.protocol=1;
+		else if(m_wire_info_hash.has_v2()&&req.info_hash==m_wire_info_hash.get(protocol_version::V2)) event.protocol=2;
+		else kind=BiglybtcTrackerResponseKindV1::Lost;
+		if(!event.request||event.request_started_nanoseconds<=0) kind=BiglybtcTrackerResponseKindV1::Lost;
+		try {auto const hash=hasher256(span<char const>(req.url.data(),req.url.size())).final();std::copy(hash.begin(),hash.end(),event.tracker_sha256.begin());}
+		catch(...) {kind=BiglybtcTrackerResponseKindV1::Lost;}
+		event.kind=kind;event.fields=fields;
+		if(kind==BiglybtcTrackerResponseKindV1::Lost) m_biglybtc_response_lost=true;
+		m_biglybtc_response_observer->observe(event);
+	}
+	void torrent::biglybtc_queue_dispatch(tracker_request& req)
+	{
+		if(!m_biglybtc_queue_observer&&!m_biglybtc_response_observer) return;
+		if(m_biglybtc_queue_request==(std::numeric_limits<std::uint64_t>::max)()) {
+			biglybtc_queue_event(BiglybtcQueueEventKindV1::Lost);biglybtc_tracker_response_event(BiglybtcTrackerResponseKindV1::Lost,req,{});return;
+		}
+		req.biglybtc_queue_request=++m_biglybtc_queue_request;
+		req.biglybtc_queue_started_nanoseconds=std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count();
+		req.biglybtc_queue_started_wall_milliseconds=std::chrono::duration_cast<std::chrono::milliseconds>(
+			std::chrono::system_clock::now().time_since_epoch()).count();
+	}
+	void torrent::biglybtc_queue_event(BiglybtcQueueEventKindV1 kind,
+		tracker_request const* req,int const seeds,int const peers) noexcept
+	{
+		if(!m_biglybtc_queue_observer||m_biglybtc_queue_lost) return;
+		if(m_biglybtc_queue_sequence==(std::numeric_limits<std::uint64_t>::max)()) kind=BiglybtcQueueEventKindV1::Lost;
+		BiglybtcQueueEventV1 event{};event.sequence=m_biglybtc_queue_sequence;
+		if(kind!=BiglybtcQueueEventKindV1::Lost) event.sequence=++m_biglybtc_queue_sequence;
+		event.kind=static_cast<std::uint32_t>(kind);event.seeds=seeds;event.peers=peers;
+		event.observed_nanoseconds=std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count();
+		event.observed_wall_milliseconds=std::chrono::duration_cast<std::chrono::milliseconds>(
+			std::chrono::system_clock::now().time_since_epoch()).count();
+		if(req) {
+			event.request=req->biglybtc_queue_request;
+			event.request_started_nanoseconds=req->biglybtc_queue_started_nanoseconds;
+			event.request_started_wall_milliseconds=req->biglybtc_queue_started_wall_milliseconds;
+			if(m_wire_info_hash.has_v1()&&req->info_hash==m_wire_info_hash.v1) event.protocol=1;
+			else if(m_wire_info_hash.has_v2()&&req->info_hash==m_wire_info_hash.get(protocol_version::V2)) event.protocol=2;
+			else {kind=BiglybtcQueueEventKindV1::Lost;event.kind=static_cast<std::uint32_t>(kind);}
+			try {
+				auto const digest=hasher256(span<char const>(req->url.data(),req->url.size())).final();
+				std::copy(digest.begin(),digest.end(),event.tracker_sha256.begin());
+			} catch(...) {kind=BiglybtcQueueEventKindV1::Lost;event.kind=static_cast<std::uint32_t>(kind);}
+		}
+		if(kind==BiglybtcQueueEventKindV1::Lost) m_biglybtc_queue_lost=true;
+		m_biglybtc_queue_observer->observe(event);
+	}
