+      entry ping;ping["q"]="ping";bool callback=false;auto const previous=sent.size();
+      tracker->direct_request(remote,ping,[&](dht::msg const&){callback=true;});TEST_EQUAL(sent.size(),previous+1);
+      if(sent.size()!=previous+1){continue;}
+      auto const outgoing=sent.back();TEST_CHECK(outgoing.socket==handle);TEST_CHECK(outgoing.endpoint==remote);
+      error_code ec;bdecode_node packet;bdecode(outgoing.bytes.data(),outgoing.bytes.data()+outgoing.bytes.size(),packet,ec);TEST_CHECK(!ec);
+      auto transaction=packet.dict_find_string_value("t");TEST_CHECK(!transaction.empty());
+      TEST_CHECK(packet.dict_find_dict("a").dict_find_string_value("id")==key.to_string());
+      entry reply;reply["y"]="r";reply["t"]=transaction.to_string();reply["r"]["id"]=std::string(20,'K');
+      std::vector<char> response;bencode(std::back_inserter(response),reply);
+      TEST_CHECK(tracker->incoming_packet(handle,remote,span<char const>(response.data(),response.size())));TEST_CHECK(callback);
+      auto q=query(i,2);std::fill(q.remote.id.begin(),q.remote.id.end(),static_cast<unsigned char>('K'));
+      q.remote.family=remote.address().is_v4()?4:6;q.remote.port=remote.port();
+      if(i==0){auto bytes=remote.address().to_v4().to_bytes();std::copy(bytes.begin(),bytes.end(),q.remote.address.begin());}
+      else{q.remote.address=remote.address().to_v6().to_bytes();}
+      auto match=tracker->biglybtc_routing_query(q);TEST_EQUAL(match.result,0U);TEST_EQUAL(match.matched,1U);
+      TEST_EQUAL(match.cookie,q.cookie);TEST_EQUAL(match.generation,q.generation);TEST_CHECK(match.local.address==q.local.address);
+      auto replay=tracker->biglybtc_routing_query(q);TEST_EQUAL(replay.result,std::uint32_t(BiglybtcMainlineRoutingResultV1::InvalidArgument));
