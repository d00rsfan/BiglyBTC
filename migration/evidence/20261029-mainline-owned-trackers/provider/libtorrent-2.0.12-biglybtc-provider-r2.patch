diff --git a/include/libtorrent/biglybtc_mainline_identity.hpp b/include/libtorrent/biglybtc_mainline_identity.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..f9df32e3689583e6d2ff24e8586c20b937d7b120
--- /dev/null
+++ b/include/libtorrent/biglybtc_mainline_identity.hpp
@@ -0,0 +1,63 @@
+// Optional exact-source/artifact-bound original mlDHT local-ID policy.
+// No stock policy or remote-node BEP42 validation changes without this opt-in.
+#ifndef TORRENT_BIGLYBTC_MAINLINE_IDENTITY_HPP
+#define TORRENT_BIGLYBTC_MAINLINE_IDENTITY_HPP
+#include "libtorrent/config.hpp"
+#include "libtorrent/fwd.hpp"
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <type_traits>
+#define TORRENT_BIGLYBTC_MAINLINE_IDENTITY_ABI 1
+namespace libtorrent {
+struct BiglybtcMainlineIdentityBindingV1 {
+  std::array<unsigned char,16> address; // Actual local address; V4 tail must0.
+  std::array<unsigned char,20> key; // Exact original derived key, including0.
+  std::uint32_t family; //4 or6; at most ONE explicitly bound socket per family.
+  std::uint32_t slot; // Only original first free slot0 currently supported.
+  std::uint16_t port;
+  std::uint16_t reserved;
+};
+struct BiglybtcMainlineIdentityPolicyV1 {
+  std::uint32_t version, size, count, reserved; // version1,size=sizeof, count1 or2 (one per family).
+  std::uint64_t generation; // Nonzero, fixed for the real session lifetime.
+  std::array<BiglybtcMainlineIdentityBindingV1,2> bindings;
+};
+struct BiglybtcMainlineIdentityEventV1 {
+  std::uint64_t generation, sequence;
+  std::uint32_t kind, reserved; // Adopted1, Retired2, Lost3.
+  BiglybtcMainlineIdentityBindingV1 binding;
+};
+struct BiglybtcMainlineIdentityStatusV1 {
+  std::uint64_t generation, adopted, retired;
+  std::uint32_t phase, expected_mask, active_mask, reserved; // Configured1,Active2,Failed3.
+  std::array<BiglybtcMainlineIdentityBindingV1,2> bindings; // Actual last adoption.
+};
+static_assert(std::is_standard_layout<BiglybtcMainlineIdentityPolicyV1>::value
+    &&std::is_trivially_copyable<BiglybtcMainlineIdentityPolicyV1>::value,"Identity policy POD");
+static_assert(sizeof(BiglybtcMainlineIdentityBindingV1)==48
+    &&sizeof(BiglybtcMainlineIdentityPolicyV1)==120
+    &&sizeof(BiglybtcMainlineIdentityEventV1)==72
+    &&sizeof(BiglybtcMainlineIdentityStatusV1)==136,"Identity ABI sizes");
+// Called only on the actual LT executor, including real node destruction.
+// Must not block/allocate/throw/call LT. False irreversibly fences this policy's
+// DHT sends/receives. Observer must retain the SAME authenticated provider pin.
+struct BiglybtcMainlineIdentityObserverV1 {
+  virtual ~BiglybtcMainlineIdentityObserverV1()=default;
+  virtual bool observe(BiglybtcMainlineIdentityEventV1 const&) noexcept=0;
+};
+enum class BiglybtcMainlineIdentityResultV1 : std::uint32_t {
+  Accepted=0, InvalidArgument=1, Busy=2, InvalidHandle=3, Failed=4
+};
+extern "C" TORRENT_EXPORT unsigned biglybtc_mainline_identity_abi_v1() noexcept;
+// Synchronous real-executor installation ONLY while DHT is disabled/uncreated.
+// Exactly once per session; no replacing/rebinding policy, no settings restore.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_configure_mainline_identity_v1(
+    session_handle const*,BiglybtcMainlineIdentityPolicyV1 const*,
+    std::shared_ptr<BiglybtcMainlineIdentityObserverV1> const*) noexcept;
+// Synchronous real-executor snapshot. Accepted means the read completed; only
+// phaseActive+all actual adoption acknowledgements confer local-ID readiness.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_read_mainline_identity_v1(
+    session_handle const*,BiglybtcMainlineIdentityStatusV1*) noexcept;
+}
+#endif
diff --git a/include/libtorrent/biglybtc_mainline_port.hpp b/include/libtorrent/biglybtc_mainline_port.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..22f2a0b0e06fdaa895e2d9f0ad8b022fc9d6fadf
--- /dev/null
+++ b/include/libtorrent/biglybtc_mainline_port.hpp
@@ -0,0 +1,56 @@
+// Optional exact-source/artifact-bound LT2.0.12 BEP5 bridge. A header/marker is
+// not runtime authority. Existing provider ABIs and extension vtables unchanged.
+#ifndef TORRENT_BIGLYBTC_MAINLINE_PORT_HPP
+#define TORRENT_BIGLYBTC_MAINLINE_PORT_HPP
+#include "libtorrent/config.hpp"
+#include "libtorrent/fwd.hpp"
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <type_traits>
+#define TORRENT_BIGLYBTC_MAINLINE_PORT_ABI 1
+namespace libtorrent {
+enum class BiglybtcMainlinePortEventKindV1 : std::uint32_t { Received=1, Lost=2 };
+struct BiglybtcMainlinePortEventV1 {
+    std::uint64_t sequence;
+    std::uint64_t admission;
+    std::array<unsigned char,20> wire_info_hash; // Actual connected wire swarm, including truncated V2.
+    std::array<unsigned char,16> address; // Actual numeric peer socket; V4 occupies first4, rest0.
+    std::uint16_t peer_port;
+    std::uint16_t dht_port;
+    std::uint32_t family; //4 or6
+    std::uint32_t protocol; //1=V1,2=V2
+    std::uint32_t kind;
+    std::uint32_t reserved;
+};
+static_assert(sizeof(BiglybtcMainlinePortEventV1)==72,"Mainline PORT event ABI size");
+static_assert(std::is_standard_layout<BiglybtcMainlinePortEventV1>::value
+    &&std::is_trivially_copyable<BiglybtcMainlinePortEventV1>::value,"Mainline PORT event POD");
+// Each admitted torrent owns its sink until real destruction. Both callbacks
+// run only on the actual LT executor. They must not block, allocate, throw or
+// call LT. No provider-side event queue, timer, status query or private pointer.
+// The owner implements a bounded queue and sticky overflow/loss withdrawal.
+struct BiglybtcMainlinePortObserverV1 {
+    virtual ~BiglybtcMainlinePortObserverV1()=default;
+    // Owner-controlled atomic snapshot:0 withdraws BOTH directions. Nonzero is
+    // permitted only for the SAME live eligible dedicated DHT service listener.
+    // Already queued transport bytes still require real retirement to drain.
+    virtual std::uint16_t advertised_port() const noexcept=0;
+    virtual void observe(BiglybtcMainlinePortEventV1 const&) noexcept=0;
+};
+enum class BiglybtcMainlinePortStatusV1 : std::uint32_t {
+    Accepted=0, InvalidArgument=1, InvalidHandle=2, WrongThread=3, AlreadyBound=4, Failed=5
+};
+extern "C" TORRENT_EXPORT unsigned biglybtc_mainline_port_abi_v1() noexcept;
+// Attach exactly once in the existing extension factory before connections.
+// Admission must be nonzero. Sink must retain the exact authenticated provider
+// mapping. Failure does not replace another sink; no dispatch or waiting.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_attach_mainline_port_observer_v1(
+    torrent_handle const*,std::shared_ptr<BiglybtcMainlinePortObserverV1> const*,std::uint64_t admission) noexcept;
+// Same real-executor contract. Explicitly refresh existing handshaked peers
+// after an atomic port transition; this creates no plugin and no timer. A stale
+// admission fails. The getter is rechecked before each actual message send.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_refresh_mainline_port_v1(
+    torrent_handle const*,std::uint64_t admission) noexcept;
+}
+#endif
diff --git a/include/libtorrent/biglybtc_mainline_routing.hpp b/include/libtorrent/biglybtc_mainline_routing.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..318888865973bd38f1cdbd6f88f990e44d10c181
--- /dev/null
+++ b/include/libtorrent/biglybtc_mainline_routing.hpp
@@ -0,0 +1,44 @@
+// Optional exact-installed-socket routing proof. No stock policy changes.
+#ifndef TORRENT_BIGLYBTC_MAINLINE_ROUTING_HPP
+#define TORRENT_BIGLYBTC_MAINLINE_ROUTING_HPP
+#include "libtorrent/biglybtc_mainline_identity.hpp"
+#define TORRENT_BIGLYBTC_MAINLINE_ROUTING_ABI 1
+namespace libtorrent {
+struct BiglybtcMainlineRoutingNodeV1 {
+  std::array<unsigned char,16> address;
+  std::array<unsigned char,20> id;
+  std::uint16_t port, family; // Numeric actual remote UDP endpoint; family4/6.
+};
+struct BiglybtcMainlineRoutingQueryV1 {
+  std::uint32_t version,size,mode,reserved; // version1, sizeof, List1 or Match2.
+  std::uint64_t generation,cookie; // Installed generation; strictly increasing nonzero cookie.
+  BiglybtcMainlineIdentityBindingV1 local; // Exact INSTALLED binding, never authority by itself.
+  BiglybtcMainlineRoutingNodeV1 remote; // Match2 only; all zero for List1.
+};
+struct BiglybtcMainlineRoutingAckV1 {
+  std::uint64_t generation,cookie;
+  BiglybtcMainlineIdentityBindingV1 local; // Actual adopted FD endpoint+actual node ID.
+  std::uint32_t result,count,matched,overflow;
+  std::array<BiglybtcMainlineRoutingNodeV1,256> nodes; // List1, ACTIVE entries only.
+};
+enum class BiglybtcMainlineRoutingResultV1 : std::uint32_t {
+  Accepted=0, InvalidArgument=1, NotReady=2, NoSocket=3, InvalidHandle=4, Failed=5
+};
+static_assert(sizeof(BiglybtcMainlineRoutingNodeV1)==40
+    &&sizeof(BiglybtcMainlineRoutingQueryV1)==120
+    &&sizeof(BiglybtcMainlineRoutingAckV1)==10320,"Routing POD sizes");
+static_assert(std::is_standard_layout<BiglybtcMainlineRoutingAckV1>::value
+    &&std::is_trivially_copyable<BiglybtcMainlineRoutingAckV1>::value,"Routing ACK POD");
+extern "C" TORRENT_EXPORT unsigned biglybtc_mainline_routing_abi_v1() noexcept;
+// Synchronous actual LT executor query. Only a currently installed, fully
+// adopted original-ID policy may answer. The local tuple, generation and cookie
+// are checked against real state; caller data cannot create/choose a socket.
+// No callback/caller pointer is retained. Output is cleared on every refusal.
+// List overflow is explicit, never silently treated as a complete live table.
+// Match scans ALL active-bucket entries, excluding replacements. Membership
+// alone grants no responder/source authority; the consumer correlates the real
+// RPC response first and queues this read after node_seen on the SAME executor.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_query_mainline_routing_v1(
+    session_handle const*,BiglybtcMainlineRoutingQueryV1 const*,BiglybtcMainlineRoutingAckV1*) noexcept;
+}
+#endif
diff --git a/include/libtorrent/biglybtc_payload_counters.hpp b/include/libtorrent/biglybtc_payload_counters.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..a9730b17a0aa9cdb0a71e029a97deb0a5d9b47a0
--- /dev/null
+++ b/include/libtorrent/biglybtc_payload_counters.hpp
@@ -0,0 +1,89 @@
+// Supported only by the reviewed BiglyBTC LT2.0.12 provider.
+// This is a source/artifact-bound C++-handle ABI, not an upstream portable API.
+#ifndef TORRENT_BIGLYBTC_PAYLOAD_COUNTERS_HPP
+#define TORRENT_BIGLYBTC_PAYLOAD_COUNTERS_HPP
+
+#include "libtorrent/config.hpp"
+#include "libtorrent/fwd.hpp"
+#include <cstdint>
+#include <type_traits>
+
+namespace libtorrent {
+// Raw m_stat values copied in the provider, before the caller's existing
+// on_resume callback returns to LT's normal clear/reset path. No epoch, total,
+// reset, ownership/finality claim or private-class pointer crosses this ABI.
+struct BiglybtcPayloadCountersV1 {
+    std::int64_t received;
+    std::int64_t sent;
+    std::uint32_t files_checked;
+    std::uint32_t reserved;
+};
+static_assert(sizeof(BiglybtcPayloadCountersV1) == 24, "Counter ABI size");
+static_assert(std::is_standard_layout<BiglybtcPayloadCountersV1>::value
+    && std::is_trivially_copyable<BiglybtcPayloadCountersV1>::value, "Counter ABI layout");
+
+enum class BiglybtcPayloadCounterStatusV1 : std::uint32_t {
+    Accepted = 0, InvalidArgument = 1, InvalidHandle = 2,
+    WrongThread = 3, InvalidCounters = 4, Failed = 5
+};
+
+extern "C" TORRENT_EXPORT unsigned biglybtc_payload_counter_abi_v1() noexcept;
+// Only call from a callback on this handle's real io_context executor thread.
+// Unlike status(), this never dispatches or waits. Failure leaves *output
+// unchanged. A temporary weak-lock is released before the function returns.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_read_payload_counters_v1(
+    torrent_handle const* handle, BiglybtcPayloadCountersV1* output,
+    std::uint32_t output_bytes) noexcept;
+
+// Optional extension. Presence of this header/marker is NOT runtime approval;
+// the consumer must authenticate and retain the exact mapped source-bound DSO.
+#define TORRENT_BIGLYBTC_TRAFFIC_COUNTERS_ABI 2
+struct BiglybtcTrafficCountersV2 {
+    BiglybtcPayloadCountersV1 payload;
+    std::int64_t protocol_received;
+    std::int64_t protocol_sent;
+    // Zero means protocol fields are unknown and MUST NOT be used as zeros.
+    // Payload acceptance remains independent of optional protocol overflow.
+    std::uint32_t protocol_known;
+    std::uint32_t reserved;
+};
+static_assert(sizeof(BiglybtcTrafficCountersV2) == 48, "Traffic counter ABI size");
+static_assert(std::is_standard_layout<BiglybtcTrafficCountersV2>::value
+    && std::is_trivially_copyable<BiglybtcTrafficCountersV2>::value, "Traffic counter ABI layout");
+enum class BiglybtcTrafficCounterStatusV2 : std::uint32_t {
+    Accepted = 0, InvalidArgument = 1, InvalidHandle = 2,
+    WrongThread = 3, InvalidCounters = 4, Failed = 5
+};
+extern "C" TORRENT_EXPORT unsigned biglybtc_traffic_counter_abi_v2() noexcept;
+// SAME executor-thread/no-dispatch/weak-lock/output-unchanged contract as v1.
+// One statistics copy supplies payload AND protocol; no IP/DHT/tracker total,
+// lifetime/finality or reset-epoch authority is exported.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_read_traffic_counters_v2(
+    torrent_handle const* handle, BiglybtcTrafficCountersV2* output,
+    std::uint32_t output_bytes) noexcept;
+
+// Additive raw bad-byte extension; ABI1/2 definitions/exports remain unchanged.
