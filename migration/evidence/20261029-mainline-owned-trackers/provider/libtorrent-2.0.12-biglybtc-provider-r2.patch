+// Source-only tests for the source-qualified BiglyBTC provider extension.
+// These do not certify actual selected/unselected wire traffic or hash IO.
+#include "test.hpp"
+#include "libtorrent/biglybtc_swarm.hpp"
+#include "libtorrent/add_torrent_params.hpp"
+#include "libtorrent/bencode.hpp"
