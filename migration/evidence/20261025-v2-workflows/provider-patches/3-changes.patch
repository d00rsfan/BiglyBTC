+	extern "C" std::uint32_t biglybtc_read_payload_counters_v1(
+		torrent_handle const* handle, BiglybtcPayloadCountersV1* output,
+		std::uint32_t const output_bytes) noexcept
+	{
+		using result = BiglybtcPayloadCounterStatusV1;
+		if (handle == nullptr || output == nullptr
+			|| output_bytes != sizeof(BiglybtcPayloadCountersV1))
+			return static_cast<std::uint32_t>(result::InvalidArgument);
+		try
+		{
+			// The layout and inline stat read stay inside their defining DSO.
+			// Never dispatch: a delayed read would miss the pre-clear boundary.
+			auto const t = handle->m_torrent.lock();
+			if (!t) return static_cast<std::uint32_t>(result::InvalidHandle);
+			if (!t->session().get_context().get_executor().running_in_this_thread())
+				return static_cast<std::uint32_t>(result::WrongThread);
+			auto const raw = t->statistics();
+			auto const received = raw.total_payload_download();
+			auto const sent = raw.total_payload_upload();
+			if (received < 0 || sent < 0)
+				return static_cast<std::uint32_t>(result::InvalidCounters);
+			BiglybtcPayloadCountersV1 const value{received, sent,
+				t->are_files_checked() ? 1u : 0u, 0u};
+			*output = value;
+			return static_cast<std::uint32_t>(result::Accepted);
+		}
+		catch (...) { return static_cast<std::uint32_t>(result::Failed); }
+	}
