+#endif
+};
+struct Socket final : dht::socket_manager {
+  bool has_quota() override {return true;}
+  bool send_packet(aux::listen_socket_handle const&,entry&,udp::endpoint const&) override {return true;}
+};
+struct Sink final : BiglybtcMainlineIdentityObserverV1 {
+  std::array<BiglybtcMainlineIdentityEventV1,8> events{};
+  unsigned count=0; bool accept=true;
+  bool observe(BiglybtcMainlineIdentityEventV1 const& event) noexcept override {
+    if(count==events.size()){return false;}events[count++]=event;return accept;
+  }
+};
+void external(std::shared_ptr<aux::listen_socket_t> const& socket,address const& value) {
+  socket->external_address=ip_voter{};
+  socket->external_address.cast_vote(value,aux::session_interface::source_dht,
+      make_address(value.is_v4()?"93.184.216.35":"2001:4860:4860::8844"));
+  TEST_CHECK(socket->external_address.external_address()==value);
+}
+auto local_socket(io_context& io,bool v6) {
+  auto socket=std::make_shared<aux::listen_socket_t>();
+  socket->udp_sock=std::make_shared<aux::session_udp_socket>(io,aux::listen_socket_handle(socket));
+  error_code ec;
+  socket->udp_sock->sock.open(v6?udp::v6():udp::v4(),ec);TEST_CHECK(!ec);
+  socket->udp_sock->sock.bind({make_address(v6?"::1":"127.0.0.1"),0},ec);TEST_CHECK(!ec);
+  auto const actual=socket->udp_sock->sock.local_endpoint(ec);TEST_CHECK(!ec);TEST_CHECK(actual.port()!=0);
+  socket->local_endpoint={actual.address(),actual.port()};return socket;
+}
+auto policy(udp::endpoint const& endpoint,dht::node_id const& key) {
+  BiglybtcMainlineIdentityPolicyV1 result{};
+  result.version=1;result.size=sizeof(result);result.count=1;result.generation=17;
+  auto& binding=result.bindings[0];binding.family=endpoint.address().is_v4()?4:6;binding.port=endpoint.port();
+  if(binding.family==4){auto bytes=endpoint.address().to_v4().to_bytes();std::copy(bytes.begin(),bytes.end(),binding.address.begin());}
+  else{binding.address=endpoint.address().to_v6().to_bytes();}
+  std::copy_n(reinterpret_cast<unsigned char const*>(key.data()),20,binding.key.begin());return result;
+}
+void original_update(bool v6,bool zero) {
+  io_context io;auto socket=local_socket(io,v6);
+  auto const first=make_address(v6?"2001:4860:4860::8888":"93.184.216.34");
+  auto const second=make_address(v6?"2606:4700:4700::1111":"1.1.1.1");
+  external(socket,first);dht::node_id key{};
+  if(!zero){std::fill_n(key.data(),20,char(0x5a));if(dht::verify_id(key,first)){key[0]^=0x80;}}
+  TEST_CHECK(zero||!dht::verify_id(key,first));
+  aux::session_settings settings;counters counters;Observer observer;Socket manager;
+  auto storage=dht::dht_default_storage_constructor(settings);
+  auto foreign=[](dht::node_id const&,std::string const&)->dht::node*{return nullptr;};
+  dht::node original(socket,&manager,settings,key,&observer,counters,foreign,*storage,true);
+  TEST_EQUAL(original.nid(),key);external(socket,second);original.update_node_id();TEST_EQUAL(original.nid(),key);
+  // The stock control still derives a valid local ID from each public address.
+  external(socket,first);dht::node stock(socket,&manager,settings,key,&observer,counters,foreign,*storage);
+  TEST_CHECK(!stock.nid().is_all_zeros());TEST_CHECK(dht::verify_id(stock.nid(),first));external(socket,second);stock.update_node_id();
+  TEST_CHECK(dht::verify_id(stock.nid(),second));
+}
+void actual_lifecycle(bool v6,bool zero) {
+  io_context io;auto socket=local_socket(io,v6);aux::listen_socket_handle handle(socket);
+  dht::node_id key{};if(!zero){std::fill_n(key.data(),20,char(0x37));}
+  auto requested=policy(handle.get_udp_local_endpoint(),key);TEST_CHECK(aux::biglybtc_mainline_identity::valid(requested));
+  auto sink=std::make_shared<Sink>();auto state=std::make_shared<aux::biglybtc_mainline_identity>(requested,sink);
+  aux::session_settings settings;counters counters;Observer observer;auto storage=dht::dht_default_storage_constructor(settings);
+  auto tracker=std::make_shared<dht::dht_tracker>(&observer,io,
+      [](aux::listen_socket_handle const&,udp::endpoint const&,span<char const>,error_code&,udp_send_flags_t){},
+      settings,counters,*storage,dht::dht_state{},state);
+  tracker->new_socket(handle);TEST_EQUAL(sink->count,1U);TEST_EQUAL(sink->events[0].kind,1U);
+  TEST_EQUAL(sink->events[0].binding.port,handle.get_udp_local_endpoint().port());
+  TEST_CHECK(sink->events[0].binding.key==requested.bindings[0].key);TEST_CHECK(state->ready());
+  auto actual=tracker->state();TEST_EQUAL(actual.nids.size(),1U);TEST_EQUAL(actual.nids[0].second,key);
+  external(socket,make_address(v6?"2001:4860:4860::8888":"93.184.216.34"));tracker->update_node_id(handle);
+  TEST_EQUAL(tracker->state().nids[0].second,key);
+  socket->udp_sock->sock.close();TEST_EQUAL(handle.get_udp_local_endpoint().port(),0);
+  tracker->delete_socket(handle);TEST_EQUAL(sink->count,2U);TEST_EQUAL(sink->events[1].kind,2U);
+  TEST_EQUAL(sink->events[1].binding.port,requested.bindings[0].port);
+  TEST_EQUAL(sink->events[1].sequence,2U);TEST_EQUAL(state->status.retired,1U);TEST_CHECK(!state->ready());
+  // Retirement used the captured real endpoint even if the FD has since closed.
+  tracker.reset();TEST_EQUAL(sink->count,2U);
+}
