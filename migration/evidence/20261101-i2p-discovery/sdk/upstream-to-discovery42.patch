+// Inside libtorrent::aux. Private opt-in; no Qt object or user callback crosses
+// this executor. No capability is exposed by status or saved settings.
+#if TORRENT_USE_I2P
+std::uint32_t session_impl::biglybtc_configure_private_i2p_owner(BiglybtcPrivateI2pOwnerPolicyV1 const& policy)
+{
+  using result=BiglybtcPrivateI2pOwnerResultV1;
+  TORRENT_ASSERT(is_single_thread());
+  if(!i2p_owner_context::valid(policy))return std::uint32_t(result::InvalidArgument);
+  if(m_abort||m_i2p_conn.owned_bridge()||m_i2p_conn.is_open()||num_torrents()!=0
+    ||!m_settings.get_str(settings_pack::i2p_hostname).empty()
+    ||m_settings.get_int(settings_pack::i2p_port)!=0)return std::uint32_t(result::Busy);
+  for(int key:{settings_pack::enable_incoming_tcp,settings_pack::enable_outgoing_tcp,
+    settings_pack::enable_incoming_utp,settings_pack::enable_outgoing_utp,
+    settings_pack::enable_dht,settings_pack::enable_lsd,settings_pack::enable_upnp,
+    settings_pack::enable_natpmp,settings_pack::allow_i2p_mixed})
+    if(m_settings.get_bool(key))return std::uint32_t(result::InvalidArgument);
+  if(m_settings.get_int(settings_pack::proxy_type)!=settings_pack::none
+    ||!m_settings.get_str(settings_pack::listen_interfaces).empty())return std::uint32_t(result::InvalidArgument);
+  m_i2p_conn.set_owned_bridge(std::make_shared<i2p_owner_context>(policy));
+  return std::uint32_t(result::Accepted);
+}
+BiglybtcPrivateI2pOwnerStatusV1 session_impl::biglybtc_private_i2p_owner_status()const
+{
+  TORRENT_ASSERT(is_single_thread());BiglybtcPrivateI2pOwnerStatusV1 status;
+  if(auto owner=m_i2p_conn.owned_bridge();owner&&!owner->mixed){
+    status.generation=owner->policy.generation;status.admission=owner->policy.admission;
+    status.public_destination_hash=owner->policy.public_destination_hash;
+    status.bridge_port=owner->policy.bridge_port;status.phase=owner->current()?1U:2U;
+  }return status;
+}
+std::uint32_t session_impl::biglybtc_withdraw_private_i2p_owner(std::uint64_t generation)
+{
+  TORRENT_ASSERT(is_single_thread());using result=BiglybtcPrivateI2pOwnerResultV1;
+  auto owner=m_i2p_conn.owned_bridge();
+  if(!owner||owner->mixed||owner->policy.generation!=generation)return std::uint32_t(result::Stale);
+  owner->withdraw();abort();return std::uint32_t(result::Accepted);
+}
+std::uint32_t session_impl::biglybtc_admit_private_i2p_torrent(BiglybtcPrivateI2pTorrentV1 const& p)
+{
+  TORRENT_ASSERT(is_single_thread());using R=BiglybtcPrivateI2pTorrentResultV1;
+  if(!i2p_owner_context::valid(p))return std::uint32_t(R::InvalidArgument);
+  auto owner=m_i2p_conn.owned_bridge();if(m_abort||!owner||owner->mixed||!owner->current()||p.generation!=owner->policy.generation)return std::uint32_t(R::Stale);
+  // A new tuple may not relabel an existing torrent, even after revocation.
+  for(auto const& entry:m_torrents){
+    auto const& t=*entry;auto const& hashes=t.torrent_file().info_hashes();
+    if(i2p_owner_context::aliases(p,hashes)&&t.biglybtc_i2p_admission()!=p.admission)return std::uint32_t(R::Busy);
+  }
+  return owner->admit(p);
+}
+std::uint32_t session_impl::biglybtc_revoke_private_i2p_torrent(BiglybtcPrivateI2pTorrentV1 const& p)
+{
+  TORRENT_ASSERT(is_single_thread());using R=BiglybtcPrivateI2pTorrentResultV1;
+  auto owner=m_i2p_conn.owned_bridge();if(m_abort||!owner||owner->mixed)return std::uint32_t(R::Stale);
+  const auto result=owner->revoke(p);if(result!=std::uint32_t(R::Accepted))return result;
+  // Stop this tuple's real peers and timers; never abort the shared session.
+  for(auto const& entry:m_torrents){auto& t=*entry;if(t.biglybtc_i2p_admission()!=p.admission)continue;
+    t.stop_announcing();t.disconnect_all(error_code(boost::asio::error::operation_aborted),operation_t::bittorrent);
+  }
+  return result;
+}
+
+std::uint32_t session_impl::biglybtc_authorize_i2p_metadata(BiglybtcPrivateI2pTorrentV1 const& p)
+{
+  TORRENT_ASSERT(is_single_thread());using R=BiglybtcPrivateI2pTorrentResultV1;
+  if(!i2p_owner_context::valid(p))return std::uint32_t(R::InvalidArgument);
+  auto owner=m_i2p_conn.owned_bridge();
+  if(m_abort||!owner||!owner->current()||p.generation!=owner->policy.generation)return std::uint32_t(R::Stale);
+  for(auto const& entry:m_torrents)if(i2p_owner_context::aliases(p,entry->torrent_file().info_hashes()))return std::uint32_t(R::Busy);
+  for(unsigned i=0;i<owner->used;++i){auto& r=owner->registrations[i];
+    if(r.active&&i2p_owner_context::equal(r.value,p)){r.metadata=true;return std::uint32_t(R::Accepted);}
+  }return std::uint32_t(R::Stale);
+}
+std::uint32_t session_impl::biglybtc_discovered_i2p_peer(BiglybtcI2pDiscoveredPeerV1 const& p)
+{
+  TORRENT_ASSERT(is_single_thread());using R=BiglybtcPrivateI2pTorrentResultV1;
+  if(p.version!=1||p.size!=sizeof(p)||!p.operation||!i2p_owner_context::valid(p.torrent)
+    ||std::none_of(p.peer_hash.begin(),p.peer_hash.end(),[](unsigned char b){return b!=0;}))return std::uint32_t(R::InvalidArgument);
+  auto owner=m_i2p_conn.owned_bridge();
+  if(m_abort||!owner||!owner->current()||p.torrent.generation!=owner->policy.generation
+    ||p.peer_hash==owner->policy.public_destination_hash)return std::uint32_t(R::Stale);
+  i2p_owner_context::registration* registration=nullptr;
+  for(unsigned i=0;i<owner->used;++i){auto& r=owner->registrations[i];if(r.active&&i2p_owner_context::equal(r.value,p.torrent)){registration=&r;break;}}
+  if(!registration)return std::uint32_t(R::Stale);
+  torrent* target=nullptr;
+  for(auto const& entry:m_torrents){auto& t=*entry;
+    if(!i2p_owner_context::matches(p.torrent,t.torrent_file().info_hashes()))continue;
+    if(target||!t.biglybtc_i2p_route_current(p.torrent.generation,p.torrent.admission))return std::uint32_t(R::Conflict);
+    if(t.torrent_file().is_valid()&&t.torrent_file().priv())return std::uint32_t(R::InvalidArgument);
+    target=&t;
+  }
+  if(!target||!m_i2p_conn.is_open())return std::uint32_t(R::Busy);
+  // async_name_lookup posts an aborted callback on overload. Refuse before
+  // consuming the operation so Native can retry this exact actual DHT result.
+  if(!m_i2p_conn.owned_lookup_available())return std::uint32_t(R::Capacity);
+  auto key=std::make_pair(p.operation,p.peer_hash);
+  if(std::find(registration->discovered.begin(),registration->discovered.end(),key)!=registration->discovered.end())return std::uint32_t(R::Stale);
+  if(registration->discovered.size()==256)return std::uint32_t(R::Capacity);
+  registration->discovered.push_back(key);
+  std::string name;static char const alphabet[]="abcdefghijklmnopqrstuvwxyz234567";
+  unsigned acc=0,bits=0;for(auto b:p.peer_hash){acc=(acc<<8)|b;bits+=8;while(bits>=5){bits-=5;name+=alphabet[(acc>>bits)&31];}}
+  if(bits)name+=alphabet[(acc<<(5-bits))&31];name+=".b32.i2p";
+  m_i2p_conn.async_name_lookup(name.c_str(),
+    [self=target->shared_from_this(),generation=p.torrent.generation,admission=p.torrent.admission](error_code const& ec,char const* dest){
+      self->biglybtc_dht_peer_resolved(ec,dest,generation,admission);
+    },i2p_owner_purpose::Peer,owner->policy.peer_port,owner->policy.local_peer_port,p.torrent.admission);
+  return std::uint32_t(R::Accepted);
+}
+#endif
