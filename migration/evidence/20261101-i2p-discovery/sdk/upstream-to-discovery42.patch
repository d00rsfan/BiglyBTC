+// Private executor-confined state for the optional local-ID policy.
+#ifndef TORRENT_AUX_BIGLYBTC_MAINLINE_IDENTITY_HPP
+#define TORRENT_AUX_BIGLYBTC_MAINLINE_IDENTITY_HPP
