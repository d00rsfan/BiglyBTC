+	void torrent::biglybtc_mainline_port_received(tcp::endpoint const& remote,
+		sha1_hash const& wire_hash, std::uint32_t const protocol, std::uint16_t const port) noexcept
+	{
+		if (biglybtc_mainline_port() == 0 || port == 0 || remote.port() == 0
+			|| remote.address().is_unspecified() || remote.address().is_multicast()) return;
+		if (remote.address().is_v4() && remote.address().to_v4().to_uint() == 0xffffffffu) return;
+		if (remote.address().is_v6() && (remote.address().to_v6().scope_id() != 0
+			|| remote.address().to_v6().is_v4_mapped())) return;
+		BiglybtcMainlinePortEventV1 event{};
+		event.admission = m_biglybtc_mainline_admission;
+		event.kind = static_cast<std::uint32_t>(BiglybtcMainlinePortEventKindV1::Received);
+		bool const valid_hash = (protocol == 1 && m_wire_info_hash.has_v1() && wire_hash == m_wire_info_hash.v1)
+			|| (protocol == 2 && m_wire_info_hash.has_v2() && wire_hash == m_wire_info_hash.get(protocol_version::V2));
+		if (!valid_hash || m_biglybtc_mainline_sequence == (std::numeric_limits<std::uint64_t>::max)())
+		{
+			m_biglybtc_mainline_lost = true;
+			event.kind = static_cast<std::uint32_t>(BiglybtcMainlinePortEventKindV1::Lost);
+			event.sequence = m_biglybtc_mainline_sequence;
+			m_biglybtc_mainline_observer->observe(event);
+			return;
+		}
+		event.sequence = ++m_biglybtc_mainline_sequence;
+		event.protocol = protocol;
+		event.peer_port = remote.port(); event.dht_port = port;
+		std::copy(wire_hash.begin(), wire_hash.end(), event.wire_info_hash.begin());
+		if (remote.address().is_v4())
+		{
+			event.family = 4;
+			auto const bytes = remote.address().to_v4().to_bytes();
+			std::copy(bytes.begin(), bytes.end(), event.address.begin());
+		}
+		else
+		{
+			event.family = 6;
+			auto const bytes = remote.address().to_v6().to_bytes();
+			std::copy(bytes.begin(), bytes.end(), event.address.begin());
+		}
+		m_biglybtc_mainline_observer->observe(event);
+	}
