+struct biglybtc_mainline_identity {
+  std::thread::id const executor=std::this_thread::get_id();
+  BiglybtcMainlineIdentityPolicyV1 policy;
+  BiglybtcMainlineIdentityStatusV1 status{};
+  std::shared_ptr<BiglybtcMainlineIdentityObserverV1> observer;
+  std::uint64_t sequence=0, routing_cookie=0;
+
+  static address binding_address(BiglybtcMainlineIdentityBindingV1 const& b) {
+    if(b.family==4){address_v4::bytes_type a{};std::copy_n(b.address.begin(),4,a.begin());return address_v4(a);}
+    address_v6::bytes_type a{};std::copy(b.address.begin(),b.address.end(),a.begin());return address_v6(a);
+  }
+  static bool valid(BiglybtcMainlineIdentityPolicyV1 const& p) {
+    if(p.version!=1||p.size!=sizeof(p)||!p.generation||p.reserved||(p.count<1||p.count>2)){return false;}
+    unsigned families=0;
+    for(unsigned i=0;i<p.count;++i){
+      auto const& b=p.bindings[i];if((b.family!=4&&b.family!=6)||b.slot!=0||!b.port||b.reserved){return false;}
+      auto const bit=b.family==4?1U:2U;if(families&bit){return false;}families|=bit;
+      if(b.family==4&&std::any_of(b.address.begin()+4,b.address.end(),[](unsigned char c){return c!=0;})){return false;}
+      auto const a=binding_address(b);
+      if(a.is_unspecified()||a.is_multicast()||(a.is_v4()&&a.to_v4().to_uint()==0xffffffffU)
+          ||(a.is_v6()&&(a.to_v6().is_v4_mapped()||a.to_v6().is_link_local()))){return false;}
+    }
+    for(unsigned i=p.count;i<2;++i){auto const& b=p.bindings[i];
+      if(b.family||b.slot||b.port||b.reserved
+          ||std::any_of(b.address.begin(),b.address.end(),[](unsigned char c){return c!=0;})
+          ||std::any_of(b.key.begin(),b.key.end(),[](unsigned char c){return c!=0;})){return false;}}
+    return true;
+  }
+  biglybtc_mainline_identity(BiglybtcMainlineIdentityPolicyV1 const& p,
+      std::shared_ptr<BiglybtcMainlineIdentityObserverV1> sink):policy(p),observer(std::move(sink)) {
+    status.generation=p.generation;status.phase=1;
+    for(unsigned i=0;i<p.count;++i){status.expected_mask|=p.bindings[i].family==4?1U:2U;}
+  }
+  bool ready()const{return status.phase!=3&&status.active_mask==status.expected_mask;}
+  int index(udp::endpoint const& ep)const{
+    for(unsigned i=0;i<policy.count;++i){auto const& b=policy.bindings[i];
+      if(ep.port()==b.port&&ep.address()==binding_address(b)){return int(i);}}
+    return -1;
+  }
+  bool emit(unsigned kind,BiglybtcMainlineIdentityBindingV1 const& binding) {
+    if(std::this_thread::get_id()!=executor){status.phase=3;return false;}
+    if(sequence==std::numeric_limits<std::uint64_t>::max()){status.phase=3;return false;}
+    BiglybtcMainlineIdentityEventV1 event{};event.generation=policy.generation;
+    event.sequence=++sequence;event.kind=kind;event.binding=binding;
+    if(!observer||!observer->observe(event)){status.phase=3;return false;}return true;
+  }
+  void fail(){if(status.phase!=3){status.phase=3;emit(3,{});}}
+  bool can_adopt(udp::endpoint const& ep){
+    auto const i=index(ep);if(i<0||status.phase==3){fail();return false;}
+    auto const bit=policy.bindings[unsigned(i)].family==4?1U:2U;
+    // A consumed family slot never re-adopts within this immutable generation.
+    if((status.active_mask&bit)||status.bindings[unsigned(i)].family){fail();return false;}return true;
+  }
+  bool permits(udp::endpoint const& ep){
+    auto const i=index(ep);
+    if(i<0||!ready()||!(status.active_mask&(policy.bindings[unsigned(i)].family==4?1U:2U))){fail();return false;}
+    return true;
+  }
+  dht::node_id key(udp::endpoint const& ep)const{
+    auto const i=index(ep);return dht::node_id(reinterpret_cast<char const*>(policy.bindings[unsigned(i)].key.data()));
+  }
+  bool adopted(udp::endpoint const& ep,dht::node_id const& actual){
+    auto const i=index(ep);if(i<0||status.phase==3){fail();return false;}
+    auto b=policy.bindings[unsigned(i)];std::copy_n(reinterpret_cast<unsigned char const*>(actual.data()),20,b.key.begin());
+    if(b.key!=policy.bindings[unsigned(i)].key||status.adopted==std::numeric_limits<std::uint64_t>::max()){fail();return false;}
+    status.bindings[unsigned(i)]=b;status.active_mask|=b.family==4?1U:2U;++status.adopted;
+    status.phase=ready()?2U:1U;return emit(1,b);
+  }
+  void retired(udp::endpoint const& ep){
+    auto const i=index(ep);if(i<0){fail();return;}
+    auto const bit=policy.bindings[unsigned(i)].family==4?1U:2U;
+    if(!(status.active_mask&bit)){fail();return;}
+    status.active_mask&=~bit;
+    if(status.retired==std::numeric_limits<std::uint64_t>::max()){fail();return;}
+    ++status.retired;if(status.phase!=3){status.phase=1;}emit(2,status.bindings[unsigned(i)]);
+  }
+  void retire_all(){
+    for(unsigned i=0;i<policy.count;++i){auto const& b=policy.bindings[i];
+      if(status.active_mask&(b.family==4?1U:2U)){retired(udp::endpoint(binding_address(b),b.port));}}
+  }
+};
+}}
+#endif
