+  auto invalid=requested;invalid.count=2;invalid.bindings[1]=invalid.bindings[0]; // Duplicate SAME family remains ambiguous.
+  TEST_CHECK(!aux::biglybtc_mainline_identity::valid(invalid));invalid=requested;invalid.bindings[0].slot=1;
+  TEST_CHECK(!aux::biglybtc_mainline_identity::valid(invalid));
