# Existing exact dependency, already required by adapters. No new zlib backend.
if(NOT TARGET ZLIB::ZLIB)
  find_package(ZLIB 1.3.1 EXACT REQUIRED)
endif()
add_library(biglybtc_i2cp_datagram STATIC i2cp_datagram/messages.cpp)
target_include_directories(biglybtc_i2cp_datagram PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/i2cp_datagram")
target_link_libraries(biglybtc_i2cp_datagram PUBLIC biglybtc_i2cp_session_config ZLIB::ZLIB)
target_compile_features(biglybtc_i2cp_datagram PUBLIC cxx_std_23)
target_compile_options(biglybtc_i2cp_datagram PRIVATE -Wall -Wextra -Wpedantic -Werror)
target_link_libraries(biglybtc_i2cp_initial_channel PUBLIC biglybtc_i2cp_datagram)

# Append tests section once.
if(TARGET biglybtc_i2cp_datagram)
  add_executable(biglybtc-i2cp-datagram-tests i2cp_datagram_tests.cpp)
  target_link_libraries(biglybtc-i2cp-datagram-tests PRIVATE biglybtc_i2cp_datagram)
  target_compile_options(biglybtc-i2cp-datagram-tests PRIVATE -Wall -Wextra -Wpedantic -Werror)
  add_test(NAME pure-i2cp-datagram-messages COMMAND biglybtc-i2cp-datagram-tests "${CMAKE_CURRENT_SOURCE_DIR}/fixtures/i2p-datagram")
  set_tests_properties(pure-i2cp-datagram-messages PROPERTIES TIMEOUT 60 LABELS "unit;i2p;crypto;no-network")
endif()
if(TARGET biglybtc_i2cp_initial_channel)
  add_executable(biglybtc-i2cp-datagram-channel-tests i2cp_datagram_channel_tests.cpp)
  set_target_properties(biglybtc-i2cp-datagram-channel-tests PROPERTIES AUTOMOC ON)
  target_link_libraries(biglybtc-i2cp-datagram-channel-tests PRIVATE biglybtc_i2cp_initial_channel Qt6::Test Qt6::Network)
  target_compile_definitions(biglybtc-i2cp-datagram-channel-tests PRIVATE BIGLYBTC_I2P_TEST_KEYS_DIR="${CMAKE_CURRENT_SOURCE_DIR}/fixtures/i2p-datagram")
  target_compile_options(biglybtc-i2cp-datagram-channel-tests PRIVATE -Wall -Wextra -Wpedantic -Werror)
  add_test(NAME i2cp-lease-backed-datagram-channel COMMAND biglybtc-i2cp-datagram-channel-tests)
  set_tests_properties(i2cp-lease-backed-datagram-channel PROPERTIES TIMEOUT 60 LABELS "unit;i2p;owned-loopback")
endif()
