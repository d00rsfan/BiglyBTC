# Append to services/CMakeLists after biglybtc_i2cp_initial_channel exists.
add_library(biglybtc_i2cp_session_config STATIC i2cp_session/session.cpp)
target_include_directories(biglybtc_i2cp_session_config PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/i2cp_session")
target_link_libraries(biglybtc_i2cp_session_config PUBLIC biglybtc_i2p_client_identity biglybtc_i2cp_protocol)
target_compile_features(biglybtc_i2cp_session_config PUBLIC cxx_std_23)
target_compile_options(biglybtc_i2cp_session_config PRIVATE -Wall -Wextra -Wpedantic -Werror)
target_link_libraries(biglybtc_i2cp_initial_channel PUBLIC biglybtc_i2cp_session_config)

# Append to tests/CMakeLists. Existing codec/identity/datagram tests stay intact.
if(TARGET biglybtc_i2cp_session_config)
  add_executable(biglybtc-i2cp-session-config-tests i2cp_session_config_tests.cpp)
  target_link_libraries(biglybtc-i2cp-session-config-tests PRIVATE biglybtc_i2cp_session_config)
  target_compile_options(biglybtc-i2cp-session-config-tests PRIVATE -Wall -Wextra -Wpedantic -Werror)
  add_test(NAME pure-i2cp-signed-session-config COMMAND biglybtc-i2cp-session-config-tests
    "${CMAKE_CURRENT_SOURCE_DIR}/fixtures/i2p-datagram")
  set_tests_properties(pure-i2cp-signed-session-config PROPERTIES TIMEOUT 60 LABELS "unit;i2p;crypto;no-network")
endif()
if(TARGET biglybtc-i2cp-initial-channel-tests)
  target_compile_definitions(biglybtc-i2cp-initial-channel-tests PRIVATE
    BIGLYBTC_I2P_TEST_KEYS_DIR="${CMAKE_CURRENT_SOURCE_DIR}/fixtures/i2p-datagram")
endif()
