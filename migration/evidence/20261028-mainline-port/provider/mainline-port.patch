+enum class BiglybtcMainlinePortEventKindV1 : std::uint32_t { Received=1, Lost=2 };
+struct BiglybtcMainlinePortEventV1 {
+    std::uint64_t sequence;
+    std::uint64_t admission;
+    std::array<unsigned char,20> wire_info_hash; // Actual connected wire swarm, including truncated V2.
+    std::array<unsigned char,16> address; // Actual numeric peer socket; V4 occupies first4, rest0.
+    std::uint16_t peer_port;
+    std::uint16_t dht_port;
+    std::uint32_t family; //4 or6
+    std::uint32_t protocol; //1=V1,2=V2
