+	extern "C" unsigned biglybtc_mainline_port_abi_v1() noexcept { return 1; }
+	extern "C" std::uint32_t biglybtc_attach_mainline_port_observer_v1(torrent_handle const* handle,
+		std::shared_ptr<BiglybtcMainlinePortObserverV1> const* sink, std::uint64_t const admission) noexcept
+	{
+		using result = BiglybtcMainlinePortStatusV1;
+		if (!handle || !sink || !*sink || admission == 0) return static_cast<std::uint32_t>(result::InvalidArgument);
+		try {
+			auto const t = handle->m_torrent.lock();
+			if (!t) return static_cast<std::uint32_t>(result::InvalidHandle);
+			if (!t->session().get_context().get_executor().running_in_this_thread())
+				return static_cast<std::uint32_t>(result::WrongThread);
+			return static_cast<std::uint32_t>(t->biglybtc_attach_mainline_port_observer(*sink, admission)
+				? result::Accepted : result::AlreadyBound);
+		} catch (...) { return static_cast<std::uint32_t>(result::Failed); }
+	}
+	extern "C" std::uint32_t biglybtc_refresh_mainline_port_v1(torrent_handle const* handle,
+		std::uint64_t const admission) noexcept
+	{
+		using result = BiglybtcMainlinePortStatusV1;
+		if (!handle || admission == 0) return static_cast<std::uint32_t>(result::InvalidArgument);
+		try {
+			auto const t = handle->m_torrent.lock();
+			if (!t) return static_cast<std::uint32_t>(result::InvalidHandle);
+			if (!t->session().get_context().get_executor().running_in_this_thread())
+				return static_cast<std::uint32_t>(result::WrongThread);
+			return static_cast<std::uint32_t>(t->biglybtc_refresh_mainline_port(admission)
+				? result::Accepted : result::InvalidArgument);
+		} catch (...) { return static_cast<std::uint32_t>(result::Failed); }
