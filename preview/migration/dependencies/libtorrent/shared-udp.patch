+// SPDX-License-Identifier: BSD-3-Clause
+// Additive source-bound shared-UDP API for the qualified BiglyBTC LT provider.
+#ifndef TORRENT_BIGLYBTC_PUBLIC_UDP_HPP
+#define TORRENT_BIGLYBTC_PUBLIC_UDP_HPP
+#include "libtorrent/config.hpp"
+#include "libtorrent/fwd.hpp"
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <type_traits>
+#define TORRENT_BIGLYBTC_PUBLIC_UDP_ABI 1
+namespace libtorrent {
+struct BiglybtcPublicUdpBindingV1 {
+    std::array<unsigned char,16> address;
+    std::array<unsigned char,16> external_address;
+    std::uint32_t family;
+    std::uint16_t port;
+    std::uint16_t flags; //1=local-network-only,2=expanded wildcard binding
+};
+struct BiglybtcPublicUdpPacketV1 {
+    std::array<unsigned char,16> address;
+    std::array<unsigned char,16> local_address;
+    std::uint32_t family;
+    std::uint16_t local_port;
+    std::uint16_t peer_port;
+    char const* bytes;
+    std::uint32_t size;
+    std::uint32_t reserved;
+};
+static_assert(sizeof(BiglybtcPublicUdpBindingV1)==40,"Shared UDP binding layout");
+static_assert(sizeof(BiglybtcPublicUdpPacketV1)==56,"Shared UDP packet layout");
+static_assert(std::is_standard_layout<BiglybtcPublicUdpBindingV1>::value
+    &&std::is_standard_layout<BiglybtcPublicUdpPacketV1>::value,"Shared UDP POD");
+// Callbacks run on the real LT executor. They must not block, allocate, throw,
+// call LT or retain packet pointers. Copy to a bounded owner mailbox. The atomic
+// source gate/deadline is checked immediately before each physical send.
+struct BiglybtcPublicUdpObserverV1 {
+    virtual ~BiglybtcPublicUdpObserverV1()=default;
+    virtual bool source_current() const noexcept=0;
+    virtual void receive(BiglybtcPublicUdpPacketV1 const&) noexcept=0;
+};
+enum class BiglybtcPublicUdpStatusV1:std::uint32_t {
+    Accepted=0,InvalidArgument=1,InvalidSession=2,AlreadyBound=3,Unavailable=4,
+    Authority=5,Timeout=6,Closed=7,SendFailed=8,WrongThread=9,Failed=10
+};
+extern "C" TORRENT_EXPORT unsigned biglybtc_public_udp_abi_v1() noexcept;
+// Calls are synchronous bounded posts to LT. Invoking them on LT's executor is
+// refused. Binding output capacity must be at least16.
+// A timeout cancels a queued effect; an effect already executing holds
+// the acknowledgement lock until its nonblocking UDP send has returned.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_attach_public_udp_v1(
+    session_handle const*,std::shared_ptr<BiglybtcPublicUdpObserverV1> const*,
+    std::uint16_t local_port,std::uint32_t timeout_ms,std::uint64_t* token,
+    BiglybtcPublicUdpBindingV1* bindings,std::uint32_t capacity,std::uint32_t* count) noexcept;
+// Refresh numeric listener/external-address observations without rebinding.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_public_udp_bindings_v1(
+    session_handle const*,std::uint64_t token,std::uint32_t timeout_ms,
+    BiglybtcPublicUdpBindingV1*,std::uint32_t capacity,std::uint32_t* count) noexcept;
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_detach_public_udp_v1(
+    session_handle const*,std::uint64_t token,std::uint32_t timeout_ms) noexcept;
+// Numeric unicast only, <=1500 bytes, Azureus framing only. Never sends through
+// a proxy, bypasses the active SDK IP filter, or creates/rebinds a socket.
+extern "C" TORRENT_EXPORT std::uint32_t biglybtc_send_public_udp_v1(
+    session_handle const*,std::uint64_t token,std::uint32_t family,
+    unsigned char const* address,std::uint16_t peer_port,std::uint16_t local_port,
+    unsigned char const* local_address,
+    char const* bytes,std::uint32_t size,std::uint32_t timeout_ms) noexcept;
+}
