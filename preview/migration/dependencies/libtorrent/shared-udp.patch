+namespace libtorrent {
+namespace {
+using Status=BiglybtcPublicUdpStatusV1;
+using Clock=std::chrono::steady_clock;
+std::uint32_t code(Status value){return static_cast<std::uint32_t>(value);}
+std::uint32_t word(char const* p){return(std::uint32_t(static_cast<unsigned char>(p[0]))<<24)
+    |(std::uint32_t(static_cast<unsigned char>(p[1]))<<16)
+    |(std::uint32_t(static_cast<unsigned char>(p[2]))<<8)|static_cast<unsigned char>(p[3]);}
+bool azureus(span<char const> bytes){
+    if(bytes.size()<16||bytes.size()>1500){return false;}
+    const auto first=word(bytes.data());
+    // Azureus replies carry action first; requests carry an MSB-set connection
+    // ID followed by action. Valid uTP, BEP5 and UDP-tracker frames do not match.
+    if(first>=1024&&first<=1041){return(first&1U)!=0||first==1032;}
+    if((static_cast<unsigned char>(bytes[0])&128U)==0||bytes.size()<17){return false;}
+    const auto action=word(bytes.data()+8);return action>=1024&&action<=1041;
+}
+void addressBytes(address const& value,std::array<unsigned char,16>& out){
+    out.fill(0);if(value.is_v4()){const auto bytes=value.to_v4().to_bytes();std::copy(bytes.begin(),bytes.end(),out.begin());}
+    else{out=value.to_v6().to_bytes();}
+}
+struct Work {
+    std::mutex mutex;std::condition_variable ready;bool done=false,cancelled=false;
+    Status status=Status::Failed;Clock::time_point deadline;
+    std::array<BiglybtcPublicUdpBindingV1,16> bindings{};std::uint32_t count=0;std::uint64_t token=0;
+};
+template<class F>Status invoke(session_handle const* handle,std::uint32_t timeout,std::shared_ptr<Work> const& work,F function){
+    if(!handle||timeout==0||timeout>30000){return Status::InvalidArgument;}
+    auto session=handle->native_handle();if(!session){return Status::InvalidSession;}
+    if(session->get_context().get_executor().running_in_this_thread()){return Status::WrongThread;}
+    const auto now=Clock::now();const auto budget=std::chrono::milliseconds(timeout);
+    if(now>Clock::time_point::max()-budget){return Status::InvalidArgument;}work->deadline=now+budget;
+    std::weak_ptr<aux::session_impl> weak=session;
+    boost::asio::post(session->get_context(),[weak,work,function]{
+        std::unique_lock<std::mutex> lock(work->mutex);
+        if(work->cancelled||Clock::now()>=work->deadline){work->status=Status::Timeout;}
+        else if(auto owner=weak.lock()){
+            try{work->status=function(*owner,*work);}catch(...){work->status=Status::Failed;}
+        }else{work->status=Status::Closed;}
+        work->done=true;lock.unlock();work->ready.notify_one();
+    });
+    std::unique_lock<std::mutex> lock(work->mutex);
+    if(!work->ready.wait_until(lock,work->deadline,[&]{return work->done;})){work->cancelled=true;return Status::Timeout;}
+    return work->status;
+}
+}
+namespace aux {
+BiglybtcPublicUdpStatusV1 session_impl::biglybtc_attach_public_udp(
+    std::shared_ptr<BiglybtcPublicUdpObserverV1> observer,std::uint16_t port,
+    std::uint64_t& token,BiglybtcPublicUdpBindingV1* bindings,std::uint32_t& count){
+    if(m_abort){return Status::Closed;}if(m_biglybtc_public_udp){return Status::AlreadyBound;}
+    if(m_settings.get_int(settings_pack::proxy_type)!=settings_pack::none||!observer||!observer->source_current()){return Status::Authority;}
+    const auto status=biglybtc_collect_public_udp_bindings(port,bindings,count);if(status!=Status::Accepted){return status;}
+    if(m_biglybtc_public_udp_serial==std::numeric_limits<std::uint64_t>::max()){return Status::Unavailable;}
+    m_biglybtc_public_udp=std::move(observer);m_biglybtc_public_udp_port=port;token=++m_biglybtc_public_udp_serial;return Status::Accepted;
+}
+BiglybtcPublicUdpStatusV1 session_impl::biglybtc_collect_public_udp_bindings(std::uint16_t port,
+    BiglybtcPublicUdpBindingV1* bindings,std::uint32_t& count){
+    if(m_abort){return Status::Closed;}if(m_settings.get_int(settings_pack::proxy_type)!=settings_pack::none){return Status::Authority;}
+    count=0;for(const auto& socket:m_listen_sockets){
+        if(socket->ssl!=transport::plaintext||!socket->udp_sock||(socket->flags&listen_socket_t::proxy)){continue;}
+        error_code ec;const auto local=socket->udp_sock->sock.local_endpoint(ec);if(ec||local.port()!=port){continue;}
+        if(count==16){return Status::Unavailable;}auto& value=bindings[count++];value={};addressBytes(local.address(),value.address);value.family=local.address().is_v4()?4:6;value.port=local.port();value.flags=((socket->flags&listen_socket_t::local_network)?1:0)|((socket->flags&listen_socket_t::was_expanded)?2:0);
+        const auto external=socket->external_address.external_address();if(external.is_v4()==local.address().is_v4()){addressBytes(external,value.external_address);}
+    }
+    return count?Status::Accepted:Status::Unavailable;
+}
+BiglybtcPublicUdpStatusV1 session_impl::biglybtc_public_udp_bindings(std::uint64_t token,
+    BiglybtcPublicUdpBindingV1* bindings,std::uint32_t& count){
+    if(!m_biglybtc_public_udp||token!=m_biglybtc_public_udp_serial){return Status::Authority;}
+    return biglybtc_collect_public_udp_bindings(m_biglybtc_public_udp_port,bindings,count);
+}
+BiglybtcPublicUdpStatusV1 session_impl::biglybtc_detach_public_udp(std::uint64_t token){
+    if(!m_biglybtc_public_udp||token!=m_biglybtc_public_udp_serial){return Status::Authority;}
+    m_biglybtc_public_udp.reset();m_biglybtc_public_udp_port=0;return Status::Accepted;
+}
+bool session_impl::biglybtc_receive_public_udp(std::shared_ptr<session_udp_socket> const& socket,
+    udp::endpoint const& peer,span<char const> bytes){
+    if(!m_biglybtc_public_udp||!azureus(bytes)){return false;}
+    error_code ec;const auto local=socket->sock.local_endpoint(ec);if(ec||local.port()!=m_biglybtc_public_udp_port){return false;}
+    // Frames of other protocols retain the original dispatch path, including
+    // uTP priority. This check is reached only after uTP declined this frame.
+    if(m_abort||m_settings.get_int(settings_pack::proxy_type)!=settings_pack::none
+        ||(m_ip_filter&&(m_ip_filter->access(peer.address())&ip_filter::blocked))
+        ||!m_biglybtc_public_udp->source_current()){return true;}
+    BiglybtcPublicUdpPacketV1 value{};addressBytes(peer.address(),value.address);addressBytes(local.address(),value.local_address);value.family=peer.address().is_v4()?4:6;value.peer_port=peer.port();value.local_port=local.port();value.bytes=bytes.data();value.size=static_cast<std::uint32_t>(bytes.size());m_biglybtc_public_udp->receive(value);return true;
+}
+BiglybtcPublicUdpStatusV1 session_impl::biglybtc_send_public_udp(std::uint64_t token,
+    udp::endpoint const& peer,std::uint16_t port,address const& localAddress,span<char const> bytes){
+    if(m_abort){return Status::Closed;}if(!m_biglybtc_public_udp||token!=m_biglybtc_public_udp_serial||port!=m_biglybtc_public_udp_port){return Status::Authority;}
+    if(!azureus(bytes)||peer.port()==0||peer.address().is_unspecified()
+        ||peer.address().is_multicast()
+        ||(peer.address().is_v4()&&peer.address().to_v4()==address_v4::broadcast())
+        ||(peer.address().is_v6()&&peer.address().to_v6().is_v4_mapped())){
+        return Status::InvalidArgument;
+    }
+    if(m_settings.get_int(settings_pack::proxy_type)!=settings_pack::none
+        ||(m_ip_filter&&(m_ip_filter->access(peer.address())&ip_filter::blocked))){return Status::Authority;}
+    for(const auto& socket:m_listen_sockets){
+        if(socket->ssl!=transport::plaintext||!socket->udp_sock||(socket->flags&listen_socket_t::proxy)){continue;}
+        error_code ec;const auto local=socket->udp_sock->sock.local_endpoint(ec);if(ec||local.port()!=port||local.protocol()!=peer.protocol()||local.address()!=localAddress||!socket->can_route(peer.address())){continue;}
+        if(!m_biglybtc_public_udp->source_current()){return Status::Authority;}
+        send_udp_packet(socket,peer,bytes,ec,{});return ec?Status::SendFailed:Status::Accepted;
+    }return Status::Unavailable;
+}
+}
+extern "C" unsigned biglybtc_public_udp_abi_v1() noexcept{return TORRENT_BIGLYBTC_PUBLIC_UDP_ABI;}
+extern "C" std::uint32_t biglybtc_attach_public_udp_v1(session_handle const* session,
+    std::shared_ptr<BiglybtcPublicUdpObserverV1> const* observer,std::uint16_t port,std::uint32_t timeout,
+    std::uint64_t* token,BiglybtcPublicUdpBindingV1* bindings,std::uint32_t capacity,std::uint32_t* count) noexcept{
+    try{if(!observer||!*observer||!token||!bindings||capacity<16||!count||!port){return code(Status::InvalidArgument);}auto work=std::make_shared<Work>();const auto sink=*observer;
+        const auto result=invoke(session,timeout,work,[sink,port](aux::session_impl& owner,Work& result){return owner.biglybtc_attach_public_udp(sink,port,result.token,result.bindings.data(),result.count);});
