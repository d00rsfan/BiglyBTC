+void removeOwnedTree(std::string const& path){
+    struct ::stat st{};if(::lstat(path.c_str(),&st)!=0){return;}
+    if(!S_ISDIR(st.st_mode)){::unlink(path.c_str());return;}
+    DIR* directory=::opendir(path.c_str());if(!directory){return;}while(auto* item=::readdir(directory)){const std::string name=item->d_name;if(name!="."&&name!=".."){removeOwnedTree(path+'/'+name);}}::closedir(directory);::rmdir(path.c_str());
+}
+struct Payload {
