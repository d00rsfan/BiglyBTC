+extern "C" std::uint32_t biglybtc_detach_public_udp_v1(session_handle const* session,std::uint64_t token,std::uint32_t timeout) noexcept{
+    try{if(!token){return code(Status::InvalidArgument);}auto work=std::make_shared<Work>();return code(invoke(session,timeout,work,[token](aux::session_impl& owner,Work&){return owner.biglybtc_detach_public_udp(token);}));}catch(...){return code(Status::Failed);}
+}
+extern "C" std::uint32_t biglybtc_send_public_udp_v1(session_handle const* session,std::uint64_t token,std::uint32_t family,
+    unsigned char const* input,std::uint16_t peerPort,std::uint16_t localPort,unsigned char const* localInput,char const* bytes,std::uint32_t size,std::uint32_t timeout) noexcept{
