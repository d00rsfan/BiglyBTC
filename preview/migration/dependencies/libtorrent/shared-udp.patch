+TORRENT_TEST(shared_public_udp_cancelled_send_has_no_late_physical_effect) {
+    Fixture f(false);
+    TEST_CHECK(f.ready());
+    if (!f.token) return;
+    const auto packet = candidate();
+    const auto target = bytes(f.ip);
+    auto blocker = std::make_shared<Blocker>();
+    auto entered = blocker->entered.get_future();
+    f.owner->add_extension(blocker);
+    const auto reached = entered.wait_for(std::chrono::seconds(3));
+    TEST_CHECK(reached == std::future_status::ready);
+    if (reached != std::future_status::ready) {
+        blocker->release.set_value();
+        return;
+    }
+    TEST_EQUAL(biglybtc_send_public_udp_v1(f.owner.get(), f.token, 4,
+        target.data(), f.remote.local_endpoint().port(), f.port,
+        f.bindings[0].address.data(), packet.data(), packet.size(), 2),
+        code(Status::Timeout));
+    blocker->release.set_value();
+    // This acknowledged post follows the cancelled send on the SDK executor.
+    TEST_EQUAL(biglybtc_public_udp_bindings_v1(f.owner.get(), f.token,
+        1000, f.bindings.data(), 16, &f.count), code(Status::Accepted));
+    std::array<char, 2048> received{};
+    udp::endpoint peer;
+    error_code error;
+    f.remote.receive_from(boost::asio::buffer(received), peer, 0, error);
+    TEST_CHECK(error == boost::asio::error::would_block
+        || error == boost::asio::error::try_again);
+    // Cancellation affects only this operation; a fresh authorized send works.
+    TEST_EQUAL(biglybtc_send_public_udp_v1(f.owner.get(), f.token, 4,
+        target.data(), f.remote.local_endpoint().port(), f.port,
+        f.bindings[0].address.data(), packet.data(), packet.size(), 500),
+        code(Status::Accepted));
+    TEST_EQUAL(f.receive(), packet);
+}
