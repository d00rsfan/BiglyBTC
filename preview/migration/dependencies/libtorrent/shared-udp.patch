+    }catch(...){return code(Status::Failed);}
+}
+extern "C" std::uint32_t biglybtc_public_udp_bindings_v1(session_handle const* session,
+    std::uint64_t token,std::uint32_t timeout,BiglybtcPublicUdpBindingV1* bindings,std::uint32_t capacity,std::uint32_t* count) noexcept{
+    try{if(!token||!bindings||capacity<16||!count){return code(Status::InvalidArgument);}auto work=std::make_shared<Work>();
+        const auto result=invoke(session,timeout,work,[token](aux::session_impl& owner,Work& out){return owner.biglybtc_public_udp_bindings(token,out.bindings.data(),out.count);});
