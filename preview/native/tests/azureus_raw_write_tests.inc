  void AzureusTransferTests::rawEmptyKeyFragmentsAndGapRepliesRespectBothPhysicalEnvelopes(){
    for(bool v6:{false,true}){for(std::size_t size:{0U,40U,4096U,16384U}){
      const std::string value(size,'W');auto parts=wire::fragments(wire::Type::WriteRequest,Handler,{},value);QVERIFY(parts);wire::Reassembly assembled;
      for(auto i=parts->rbegin();i!=parts->rend();++i){auto encoded=wire::encode(header(v6),*i);QVERIFY(encoded&&encoded->size()<=1430);wire::udp::Context context;context.network=0;context.now=1234;auto decoded=wire::decode(*encoded,context);QVERIFY(decoded);QVERIFY(decoded->data.key.empty());QVERIFY(assembled.add(decoded->data));}
      QCOMPARE(assembled.value(),std::optional{value});wire::WriteProgress progress;QVERIFY(progress.acknowledge({wire::Type::WriteReply,Handler,{},0,static_cast<std::int32_t>(size),0,{}},size));QVERIFY(progress.complete);
    }}
    auto gap=wire::fragments(wire::Type::ReadReply,Handler,{},std::string(4096,'R'),1317,200);QVERIFY(gap&&gap->size()==1);QCOMPARE(gap->front().start,1317);QCOMPARE(gap->front().payload,std::string(200,'R'));
  }
  void AzureusTransferTests::rawWriteRequiresExplicitRegistrationAndDoesNotTurnAckIntoCallReply(){
    Actor a("127.121.24.1"),b("127.121.24.2");QVERIFY(a.transport.allowPeer(b.transport.endpoint()));QVERIFY(b.transport.allowPeer(a.transport.endpoint()));QVERIFY(a.registerRoom(Handler));QVERIFY(b.registerRoom(Handler));
    QVERIFY(!a.transport.writeTransfer(b.transport.endpoint(),55,Handler,"raw",&a.receiver,[](auto){},std::chrono::steady_clock::now()+1s));
    QVERIFY(a.transport.unregisterTransferHandler(Handler));QVERIFY(a.transport.registerTransferHandler(Handler,true,&a.receiver,[](auto){},[]()->std::optional<std::uint64_t>{return 1;},udp::TransferMode::Call,true));
    std::optional<udp::TransferOutcome> raw;QVERIFY(a.transport.writeTransfer(b.transport.endpoint(),55,Handler,"refused",&a.receiver,[&](auto r){raw.emplace(std::move(r));},std::chrono::steady_clock::now()+100ms));QTRY_VERIFY_WITH_TIMEOUT(raw.has_value(),500);QVERIFY(!*raw&&raw->error()==udp::Failure::Timeout);QVERIFY(b.incoming.empty());
    QVERIFY(b.transport.unregisterTransferHandler(Handler));QVERIFY(!b.transport.registerTransferHandler(Handler,true,&b.receiver,[](auto){},[]()->std::optional<std::uint64_t>{return 1;},udp::TransferMode::Read,true));
    QVERIFY(b.transport.registerTransferHandler(Handler,true,&b.receiver,[&](auto request){b.incoming.push_back(request);},[]()->std::optional<std::uint64_t>{return 1;},udp::TransferMode::Call,true));
    raw.reset();QVERIFY(a.transport.writeTransfer(b.transport.endpoint(),55,Handler,"accepted",&a.receiver,[&](auto r){raw.emplace(std::move(r));},std::chrono::steady_clock::now()+1s));QTRY_VERIFY_WITH_TIMEOUT(raw.has_value()&&b.incoming.size()==1,1500);QVERIFY(*raw&&(**raw).empty());QCOMPARE(b.incoming[0]->mode,udp::TransferMode::Write);QCOMPARE(b.incoming[0]->request,std::string("accepted"));QVERIFY(!b.transport.answerTransfer(b.incoming[0]->receipt,"invented response"));
    std::optional<udp::TransferOutcome> call;QVERIFY(a.transport.callTransfer(b.transport.endpoint(),55,Handler,"ordinary",&a.receiver,[&](auto r){call.emplace(std::move(r));},std::chrono::steady_clock::now()+1s));QTRY_COMPARE_WITH_TIMEOUT(b.incoming.size(),std::size_t{2},1000);QVERIFY(!call);QCOMPARE(b.incoming[1]->mode,udp::TransferMode::Call);QVERIFY(b.transport.answerTransfer(b.incoming[1]->receipt,"real reply"));QTRY_VERIFY_WITH_TIMEOUT(call.has_value(),1500);QVERIFY(*call);QCOMPARE(**call,std::string("real reply"));
  }
  void AzureusTransferTests::rawWriteReplayRequiresExactPayloadSourceNetworkAndConnection(){
    Actor receiver("127.121.25.1");bool current=true;QVERIFY(receiver.transport.registerTransferHandler(Handler,false,&receiver.receiver,[&](auto request){receiver.incoming.push_back(std::move(request));},[&]()->std::optional<std::uint64_t>{return current?std::optional<std::uint64_t>{1}:std::nullopt;},udp::TransferMode::Write));
    QUdpSocket remote,foreign;remote.setProxy(QNetworkProxy::NoProxy);foreign.setProxy(QNetworkProxy::NoProxy);QVERIFY(remote.bind(QHostAddress("127.121.25.2"),0));QVERIFY(foreign.bind(QHostAddress("127.121.25.3"),0));QVERIFY(receiver.transport.allowPeer({remote.localAddress(),remote.localPort()}));
    auto h=header();h.now=QDateTime::currentMSecsSinceEpoch();h.originator->bytes={127,121,25,2};h.originator->port=remote.localPort();wire::Data request{wire::Type::WriteRequest,Handler,{},0,5,5,"hello"};
    const auto send=[&](QUdpSocket& socket){auto bytes=wire::encode(h,request);return bytes&&socket.writeDatagram(bytes->data(),qint64(bytes->size()),receiver.transport.endpoint().address,receiver.transport.endpoint().port)==qint64(bytes->size());};
    QVERIFY(send(foreign));h.network=4;QVERIFY(send(remote));h.network=0;QVERIFY(send(remote));QTRY_COMPARE_WITH_TIMEOUT(receiver.incoming.size(),std::size_t{1},1000);QTRY_VERIFY_WITH_TIMEOUT(remote.hasPendingDatagrams(),1000);auto first=remote.receiveDatagram().data();QVERIFY(send(remote));QTRY_VERIFY_WITH_TIMEOUT(remote.hasPendingDatagrams(),1000);auto repeated=remote.receiveDatagram().data();wire::udp::Context context;context.now=QDateTime::currentMSecsSinceEpoch();context.network=0;auto aa=wire::decode(first.toStdString(),context),bb=wire::decode(repeated.toStdString(),context);QVERIFY(aa&&bb);QCOMPARE(aa->data,bb->data);QCOMPARE(aa->data.type,wire::Type::WriteReply);QVERIFY(aa->data.key.empty());QCOMPARE(aa->header.fields().connection,h.connection);QCOMPARE(receiver.incoming.size(),std::size_t{1});
    request.payload="other";QVERIFY(send(remote));QTRY_VERIFY_WITH_TIMEOUT(receiver.transport.statistics().received>=5,1000);QVERIFY(!remote.hasPendingDatagrams());QCOMPARE(receiver.incoming.size(),std::size_t{1});current=false;request.payload="hello";QVERIFY(send(remote));QTRY_VERIFY_WITH_TIMEOUT(receiver.transport.statistics().received>=6,1000);QVERIFY(!remote.hasPendingDatagrams());QCOMPARE(receiver.incoming.size(),std::size_t{1});
  }
  void AzureusTransferTests::rawWriteCancellationAndSourceWithdrawalCannotCompleteLater(){
    Actor actor("127.121.26.1");bool current=true;QVERIFY(actor.transport.registerTransferHandler(Handler,false,&actor.receiver,[](auto){},[&]()->std::optional<std::uint64_t>{return current?std::optional<std::uint64_t>{1}:std::nullopt;},udp::TransferMode::Write));QUdpSocket remote;remote.setProxy(QNetworkProxy::NoProxy);QVERIFY(remote.bind(QHostAddress("127.121.26.2"),0));udp::Peer peer{remote.localAddress(),remote.localPort()};QVERIFY(actor.transport.allowPeer(peer));
    std::optional<udp::TransferOutcome> result;auto ticket=actor.transport.writeTransfer(peer,55,Handler,"held",&actor.receiver,[&](auto r){result.emplace(std::move(r));},std::chrono::steady_clock::now()+1s);QVERIFY(ticket);QTRY_VERIFY_WITH_TIMEOUT(remote.hasPendingDatagrams(),1000);auto datagram=remote.receiveDatagram();wire::udp::Context context;context.network=0;context.now=QDateTime::currentMSecsSinceEpoch();auto packet=wire::decode(datagram.data().toStdString(),context);QVERIFY(packet);QVERIFY(actor.transport.cancelTransfer(*ticket));QTRY_VERIFY_WITH_TIMEOUT(result.has_value(),500);QVERIFY(!*result&&result->error()==udp::Failure::Cancelled);
    auto h=header();h.now=context.now;h.connection=packet->header.fields().connection;h.originator->bytes={127,121,26,2};h.originator->port=remote.localPort();wire::Data ack{wire::Type::WriteReply,Handler,{},0,4,0,{}};auto bytes=wire::encode(h,ack);QVERIFY(bytes);QVERIFY(remote.writeDatagram(bytes->data(),qint64(bytes->size()),actor.transport.endpoint().address,actor.transport.endpoint().port)>0);
    result.reset();ticket=actor.transport.writeTransfer(peer,55,Handler,"held",&actor.receiver,[&](auto r){result.emplace(std::move(r));},std::chrono::steady_clock::now()+100ms);QVERIFY(ticket);current=false;QTRY_VERIFY_WITH_TIMEOUT(result.has_value(),500);QVERIFY(!*result);QCOMPARE(result->error(),udp::Failure::Timeout);
  }

  void AzureusTransferTests::actualOriginalEmptyKeyWrite_data(){QTest::addColumn<bool>("originalCaller");QTest::addColumn<int>("bytes");for(bool caller:{false,true}){for(int bytes:{40,4096,16384}){auto name=QByteArray(caller?"java-writes-native-":"native-writes-java-")+QByteArray::number(bytes);QTest::newRow(name.constData())<<caller<<bytes;}}}
  void AzureusTransferTests::actualOriginalEmptyKeyWrite(){
    QFETCH(bool,originalCaller);QFETCH(int,bytes);const auto classes=qEnvironmentVariable("BIGLYBTC_AZUREUS_RAW_REFERENCE_CLASSPATH"),java=qEnvironmentVariable("BIGLYBTC_AZUREUS_DATA_REFERENCE_JAVA");QVERIFY2(!classes.isEmpty()&&!java.isEmpty(),"Prepare the pinned original raw-write helper; no skip or model substitute");
    Actor native("127.121.28.1");QVERIFY(native.transport.registerTransferHandler(Handler,false,&native.receiver,[&](auto request){native.incoming.push_back(std::move(request));},[]()->std::optional<std::uint64_t>{return 1;},udp::TransferMode::Call,true));
    QTemporaryDir root;QVERIFY(root.isValid());QVERIFY(QDir().mkpath(root.path()+"/home"));QVERIFY(QDir().mkpath(root.path()+"/tmp"));QProcess peer;auto env=QProcessEnvironment::systemEnvironment();for(const auto* name:{"JAVA_TOOL_OPTIONS","_JAVA_OPTIONS","JDK_JAVA_OPTIONS","CLASSPATH"}){env.remove(QString::fromLatin1(name));}peer.setProcessEnvironment(env);peer.setProcessChannelMode(QProcess::SeparateChannels);peer.setProgram(java);peer.setArguments({"-Xmx128m","-XX:ActiveProcessorCount=1","-Duser.home="+root.path()+"/home","-Djava.io.tmpdir="+root.path()+"/tmp","-Dazureus.config.path="+root.path()+"/profile","-Djava.security.manager=allow","-cp",classes,"com.biglybt.core.dht.transport.udp.impl.OriginalRawWritePeer","127.121.28.2","0","127.121.28.1",QString::number(native.transport.endpoint().port),originalCaller?"caller":"receiver",QString::number(bytes)});
    const auto joined=qScopeGuard([&]{if(peer.state()!=QProcess::NotRunning){peer.kill();peer.waitForFinished(3000);}});peer.start();QVERIFY(peer.waitForStarted(3000));QByteArray output;QElapsedTimer ready;ready.start();while(ready.elapsed()<10000&&!output.contains("READY ")){peer.waitForReadyRead(30);output+=peer.readAllStandardOutput();QCoreApplication::processEvents();}QVERIFY2(output.contains("READY "),peer.readAllStandardError().constData());QByteArray line;for(const auto& candidate:output.split('\n')){if(candidate.startsWith("READY ")){line=candidate;break;}}bool valid=false;const auto port=line.mid(6).toInt(&valid);QVERIFY(valid&&port>0&&port<=65535);const udp::Peer actual{QHostAddress("127.121.28.2"),quint16(port)};QVERIFY(native.transport.allowPeer(actual));
    if(originalCaller){QCOMPARE(peer.write("GO\n"),qint64{3});QVERIFY(peer.waitForBytesWritten(1000));QTRY_COMPARE_WITH_TIMEOUT(native.incoming.size(),std::size_t{1},5000);QCOMPARE(native.incoming[0]->request,std::string(static_cast<std::size_t>(bytes),'q'));QCOMPARE(native.incoming[0]->mode,udp::TransferMode::Write);QVERIFY(!native.transport.answerTransfer(native.incoming[0]->receipt,"no application reply"));}
    else{std::optional<udp::TransferOutcome> result;QVERIFY(native.transport.writeTransfer(actual,55,Handler,std::string(static_cast<std::size_t>(bytes),'q'),&native.receiver,[&](auto r){result.emplace(std::move(r));},std::chrono::steady_clock::now()+5s));QTRY_VERIFY_WITH_TIMEOUT(result.has_value(),5500);QVERIFY(*result&&(**result).empty());QVERIFY(native.incoming.empty());}
    QTRY_VERIFY_WITH_TIMEOUT(peer.state()==QProcess::NotRunning,12000);QVERIFY2(peer.exitStatus()==QProcess::NormalExit&&peer.exitCode()==0,peer.readAllStandardError().constData());
