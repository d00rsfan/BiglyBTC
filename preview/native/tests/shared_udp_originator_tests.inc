void SharedUdpTests::actualSdkNatHandlerKeepsDeclaredIdentitySeparateFromSource_data(){QTest::addColumn<bool>("v6");QTest::newRow("IPv4")<<false;QTest::newRow("IPv6")<<true;}
void SharedUdpTests::actualSdkNatHandlerKeepsDeclaredIdentitySeparateFromSource(){
 QFETCH(bool,v6);Actor a(QHostAddress(v6?"::1":"127.121.28.1"),v6,0,true),b(QHostAddress(v6?"::1":"127.121.28.2"),v6,0,true);QVERIFY(a.transport.endpoint().port!=a.actualEndpoint.port);QVERIFY(b.transport.endpoint().port!=b.actualEndpoint.port);QVERIFY(a.transport.allowPeer(b.actualEndpoint));QVERIFY(b.transport.allowPeer(a.actualEndpoint));const std::string natKey(20,'N'),strictKey(20,'S');std::vector<std::shared_ptr<const udp::TransferRequest>> received;unsigned strict=0;
 const auto revision=[]()->std::optional<std::uint64_t>{return 1;};
 QVERIFY(a.transport.registerTransferHandler(natKey,false,&a.receiver,[](auto){},revision,udp::TransferMode::Call,true,udp::TransferOriginator::SameIp));
 QVERIFY(b.transport.registerTransferHandler(natKey,false,&b.receiver,[&](auto request){received.push_back(request);if(request->mode==udp::TransferMode::Call){need(bool(b.transport.answerTransfer(request->receipt,"NAT reply")),"Original actual-socket response");}},revision,udp::TransferMode::Call,true,udp::TransferOriginator::SameIp));
 QVERIFY(!a.transport.registerTransferHandler(strictKey,false,&a.receiver,[](auto){},revision,udp::TransferMode::Call,false,udp::TransferOriginator::SameIp));QVERIFY(!a.transport.registerTransferHandler(strictKey,false,&a.receiver,[](auto){},revision,udp::TransferMode::Read,true,udp::TransferOriginator::SameIp));
 QVERIFY(a.transport.registerTransferHandler(strictKey,false,&a.receiver,[](auto){},revision));QVERIFY(b.transport.registerTransferHandler(strictKey,false,&b.receiver,[&](auto){++strict;},revision));
 std::optional<udp::TransferOutcome> result;QVERIFY(a.transport.callTransfer(b.actualEndpoint,55,natKey,std::string(4096,'c'),&a.receiver,[&](auto r){result.emplace(std::move(r));},std::chrono::steady_clock::now()+2s));QTRY_VERIFY_WITH_TIMEOUT(result.has_value(),2500);if(!*result){QFAIL(qPrintable(QStringLiteral("DATA failure=%1").arg(int(result->error()))));}QCOMPARE(**result,std::string("NAT reply"));QCOMPARE(received.size(),std::size_t{1});QCOMPARE(received[0]->peer,a.actualEndpoint);QVERIFY(received[0]->advertised.address);QCOMPARE(received[0]->advertised.address->port,a.transport.endpoint().port);QCOMPARE(received[0]->advertised.protocol,55);
 result.reset();QVERIFY(a.transport.writeTransfer(b.actualEndpoint,55,natKey,"d4:typei6ee",&a.receiver,[&](auto r){result.emplace(std::move(r));},std::chrono::steady_clock::now()+1s));QTRY_VERIFY_WITH_TIMEOUT(result.has_value()&&received.size()==2,1500);QVERIFY(*result&&(**result).empty());QCOMPARE(received[1]->mode,udp::TransferMode::Write);QCOMPARE(received[1]->peer,a.actualEndpoint);QCOMPARE(received[1]->advertised.address->port,a.transport.endpoint().port);
 result.reset();QVERIFY(a.transport.callTransfer(b.actualEndpoint,55,strictKey,"strict",&a.receiver,[&](auto r){result.emplace(std::move(r));},std::chrono::steady_clock::now()+100ms));QTRY_VERIFY_WITH_TIMEOUT(result.has_value(),500);QVERIFY(!*result&&result->error()==udp::Failure::Timeout);QCOMPARE(strict,0U);QCOMPARE(received.size(),std::size_t{2});
 a.permit=false;result.reset();QVERIFY(a.transport.writeTransfer(b.actualEndpoint,55,natKey,"withdrawn",&a.receiver,[&](auto r){result.emplace(std::move(r));},std::chrono::steady_clock::now()+1s));QTRY_VERIFY_WITH_TIMEOUT(result.has_value(),500);QVERIFY(!*result&&result->error()==udp::Failure::Authority);QCOMPARE(received.size(),std::size_t{2});
}
