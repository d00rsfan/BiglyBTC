 void SharedUdpTests::actualSdkRawWriteUsesSameHandlerAndNoInventedApplicationReply_data(){QTest::addColumn<bool>("v6");QTest::newRow("IPv4")<<false;QTest::newRow("IPv6")<<true;}
 void SharedUdpTests::actualSdkRawWriteUsesSameHandlerAndNoInventedApplicationReply(){
  QFETCH(bool,v6);Actor a(QHostAddress(v6?"::1":"127.121.27.1"),v6),b(QHostAddress(v6?"::1":"127.121.27.2"),v6);QVERIFY(a.transport.allowPeer(b.transport.endpoint()));QVERIFY(b.transport.allowPeer(a.transport.endpoint()));const std::string handler(20,'N');
  std::vector<std::shared_ptr<const udp::TransferRequest>> incoming;
  QVERIFY(a.transport.registerTransferHandler(handler,true,&a.receiver,[](auto){},[&]()->std::optional<std::uint64_t>{return a.revision;},udp::TransferMode::Call,true));
  QVERIFY(b.transport.registerTransferHandler(handler,true,&b.receiver,[&](auto request){incoming.push_back(request);if(request->mode==udp::TransferMode::Call){need(bool(b.transport.answerTransfer(request->receipt,"ordinary reply")),"Original call still needs a reply");}},[&]()->std::optional<std::uint64_t>{return b.revision;},udp::TransferMode::Call,true));
  for(std::size_t size:{0U,40U,4096U,16384U}){const std::string value(size,'W');std::optional<udp::TransferOutcome> outcome;const auto count=incoming.size();QVERIFY(a.transport.writeTransfer(b.transport.endpoint(),55,handler,value,&a.receiver,[&](auto r){outcome.emplace(std::move(r));},std::chrono::steady_clock::now()+2s));QTRY_VERIFY_WITH_TIMEOUT(outcome.has_value()&&incoming.size()==count+1,2500);QVERIFY(*outcome&&(**outcome).empty());QCOMPARE(incoming.back()->request,value);QCOMPARE(incoming.back()->mode,udp::TransferMode::Write);QCOMPARE(incoming.back()->network,v6?3:0);QCOMPARE(incoming.back()->peer,a.transport.endpoint());QVERIFY(!b.transport.answerTransfer(incoming.back()->receipt,"no reply for write"));}
  std::optional<udp::TransferOutcome> outcome;QVERIFY(a.transport.callTransfer(b.transport.endpoint(),55,handler,"ordinary request",&a.receiver,[&](auto r){outcome.emplace(std::move(r));},std::chrono::steady_clock::now()+2s));QTRY_VERIFY_WITH_TIMEOUT(outcome.has_value(),2500);QVERIFY(*outcome);QCOMPARE(**outcome,std::string("ordinary reply"));QCOMPARE(incoming.size(),std::size_t{5});QCOMPARE(incoming.back()->mode,udp::TransferMode::Call);
 }
