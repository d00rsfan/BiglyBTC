+shared_scope_binding::shared_scope_binding(biglybtc_shared_quota_v1 const& o):operations(o){o.retain_scope(o.scope);}
+shared_scope_binding::~shared_scope_binding(){operations.release_scope(operations.scope);}
+bool shared_scope_binding::matches(biglybtc_shared_quota_v1 const& o)const noexcept{return operations.scope==o.scope&&operations.enter==o.enter&&operations.leave==o.leave&&operations.retain_scope==o.retain_scope&&operations.release_scope==o.release_scope;}
+shared_channel_binding::shared_channel_binding(biglybtc_shared_quota_v1 const& o,int d):operations(o),direction(d){o.retain_budget(o.budget);}
