# Private persistent-engine admission is OFF unless an exact reviewed artifact
# manifest and its source/build/install tree are available. No version fallback.
set(BIGLYBTC_PERSISTENT_RUNTIME_MANIFEST "" CACHE FILEPATH
  "Reviewed source-bound persistent-engine qualification manifest (default OFF)")
option(BIGLYBTC_PERSISTENT_COEXISTENCE_RUNTIME "Separately root-approved same-image Public/private session cohort" OFF)
set(BIGLYBTC_PERSISTENT_COEXISTENCE_APPROVAL "" CACHE FILEPATH "Exact closed Public/private role approval")
set(BIGLYBTC_PERSISTENT_COEXISTENCE_APPROVAL_SHA256 "" CACHE STRING "Actual root approval digest")
option(BIGLYBTC_PERSISTENT_MIXED_I2P_RUNTIME "Explicit closed39 mixed transport/Public/private role cohort" OFF)
set(BIGLYBTC_PERSISTENT_MIXED_I2P_APPROVAL "" CACHE FILEPATH "Exact closed mixed role approval")
set(BIGLYBTC_PERSISTENT_MIXED_I2P_APPROVAL_SHA256 "" CACHE STRING "Actual mixed root approval digest")
option(BIGLYBTC_PERSISTENT_PUBLIC_CHAT_RUNTIME "Exact derived Public-only shared-chat SDK" OFF)
if(BIGLYBTC_PERSISTENT_PUBLIC_CHAT_RUNTIME AND (BIGLYBTC_PERSISTENT_MIXED_I2P_RUNTIME OR BIGLYBTC_PERSISTENT_COEXISTENCE_RUNTIME OR BIGLYBTC_PRIVATE_I2P_PROVIDER_OWNER OR BIGLYBTC_PERSISTENT_RUNTIME_MANIFEST STREQUAL ""))
 message(FATAL_ERROR "Shared chat cohort is Public-only and requires its separate manifest")
endif()
if(BIGLYBTC_PERSISTENT_MIXED_I2P_RUNTIME)
  if(BIGLYBTC_PERSISTENT_RUNTIME_MANIFEST STREQUAL "" OR BIGLYBTC_PERSISTENT_COEXISTENCE_RUNTIME)
    message(FATAL_ERROR "Mixed requires its separate manifest; old coexistence approval cannot authorize it")
  endif()
endif()
if(BIGLYBTC_PERSISTENT_COEXISTENCE_RUNTIME AND BIGLYBTC_PERSISTENT_RUNTIME_MANIFEST STREQUAL "")
  message(FATAL_ERROR "Coexistence requires its explicit source/SDK/role manifest")
endif()
set(_biglybtc_binding_dir "${CMAKE_CURRENT_BINARY_DIR}/runtime-binding")
file(MAKE_DIRECTORY "${_biglybtc_binding_dir}")
set(_biglybtc_binding_header "${_biglybtc_binding_dir}/persistent_runtime_config.hpp")
if(BIGLYBTC_PERSISTENT_RUNTIME_MANIFEST STREQUAL "")
  file(WRITE "${_biglybtc_binding_header}"
    "#pragma once\n#define BIGLYBTC_PERSISTENT_RUNTIME_BOUND 0\n")
else()
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Persistent runtime binding currently requires Linux")
  endif()
  set(_biglybtc_lt_target LibtorrentRasterbar::torrent-rasterbar)
  get_target_property(_biglybtc_lt_alias ${_biglybtc_lt_target} ALIASED_TARGET)
  if(_biglybtc_lt_alias)
    set(_biglybtc_lt_target "${_biglybtc_lt_alias}")
  endif()
  set(_biglybtc_locations "")
  get_target_property(_biglybtc_configs ${_biglybtc_lt_target} IMPORTED_CONFIGURATIONS)
  if(NOT _biglybtc_configs)
    set(_biglybtc_configs "")
  endif()
  list(APPEND _biglybtc_configs "NOCONFIG" "DEBUG" "RELEASE" "RELWITHDEBINFO" "MINSIZEREL")
  list(REMOVE_DUPLICATES _biglybtc_configs)
  get_target_property(_biglybtc_location ${_biglybtc_lt_target} IMPORTED_LOCATION)
  if(_biglybtc_location)
    file(REAL_PATH "${_biglybtc_location}" _biglybtc_location)
    list(APPEND _biglybtc_locations "${_biglybtc_location}")
  endif()
  foreach(_biglybtc_config IN LISTS _biglybtc_configs)
    string(TOUPPER "${_biglybtc_config}" _biglybtc_config)
    get_target_property(_biglybtc_location ${_biglybtc_lt_target} IMPORTED_LOCATION_${_biglybtc_config})
    if(_biglybtc_location)
      file(REAL_PATH "${_biglybtc_location}" _biglybtc_location)
      list(APPEND _biglybtc_locations "${_biglybtc_location}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _biglybtc_locations)
  list(LENGTH _biglybtc_locations _biglybtc_location_count)
  if(NOT _biglybtc_location_count EQUAL 1)
    message(FATAL_ERROR "Persistent binding requires one unambiguous LT imported artifact")
  endif()
  get_target_property(_biglybtc_includes ${_biglybtc_lt_target} INTERFACE_INCLUDE_DIRECTORIES)
  set(_biglybtc_lt_include "")
  foreach(_biglybtc_include IN LISTS _biglybtc_includes)
    if(EXISTS "${_biglybtc_include}/libtorrent/version.hpp")
      if(NOT _biglybtc_lt_include STREQUAL "")
        message(FATAL_ERROR "Ambiguous LT header roots")
      endif()
      set(_biglybtc_lt_include "${_biglybtc_include}")
    endif()
  endforeach()
  if(_biglybtc_lt_include STREQUAL "")
    message(FATAL_ERROR "Missing LT installed header root")
  endif()
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  set(_biglybtc_runtime_verifier "${CMAKE_CURRENT_LIST_DIR}/verify_runtime_manifest_mainline_routing.py")
  set(_biglybtc_role_arguments "")
  if(BIGLYBTC_PERSISTENT_PUBLIC_CHAT_RUNTIME)
    set(_biglybtc_runtime_verifier "${CMAKE_CURRENT_LIST_DIR}/verify_runtime_manifest_public_chat.py")
  elseif(BIGLYBTC_PERSISTENT_MIXED_I2P_RUNTIME)
    if(NOT BIGLYBTC_PRIVATE_I2P_PROVIDER_OWNER OR NOT IS_ABSOLUTE "${BIGLYBTC_PERSISTENT_MIXED_I2P_APPROVAL}"
        OR NOT BIGLYBTC_PRIVATE_I2P_OWNER_APPROVAL STREQUAL BIGLYBTC_PERSISTENT_MIXED_I2P_APPROVAL
        OR NOT BIGLYBTC_PRIVATE_I2P_OWNER_APPROVAL_SHA256 STREQUAL BIGLYBTC_PERSISTENT_MIXED_I2P_APPROVAL_SHA256)
      message(FATAL_ERROR "Mixed requires the same separately approved39 image for every requested role")
    endif()
    set(_biglybtc_runtime_verifier "${CMAKE_CURRENT_LIST_DIR}/verify_runtime_manifest_mixed.py")
    list(APPEND _biglybtc_role_arguments --approval "${BIGLYBTC_PERSISTENT_MIXED_I2P_APPROVAL}"
      --approval-sha256 "${BIGLYBTC_PERSISTENT_MIXED_I2P_APPROVAL_SHA256}")
  elseif(BIGLYBTC_PERSISTENT_COEXISTENCE_RUNTIME)
    if(NOT BIGLYBTC_PRIVATE_I2P_PROVIDER_OWNER OR NOT IS_ABSOLUTE "${BIGLYBTC_PERSISTENT_COEXISTENCE_APPROVAL}" OR NOT IS_ABSOLUTE "${BIGLYBTC_PRIVATE_I2P_OWNER_APPROVAL}")
      message(FATAL_ERROR "Coexistence requires separate explicit Public and private approvals")
    endif()
    set(_biglybtc_runtime_verifier "${CMAKE_CURRENT_LIST_DIR}/verify_runtime_manifest_coexistence.py")
    list(APPEND _biglybtc_role_arguments --approval "${BIGLYBTC_PERSISTENT_COEXISTENCE_APPROVAL}"
      --approval-sha256 "${BIGLYBTC_PERSISTENT_COEXISTENCE_APPROVAL_SHA256}"
      --private-approval "${BIGLYBTC_PRIVATE_I2P_OWNER_APPROVAL}")
  endif()
  execute_process(COMMAND "${Python3_EXECUTABLE}"
    "${_biglybtc_runtime_verifier}"
    --manifest "${BIGLYBTC_PERSISTENT_RUNTIME_MANIFEST}"
    --library "${_biglybtc_locations}" --include "${_biglybtc_lt_include}"
    --header "${_biglybtc_binding_header}"
    --receipt "${_biglybtc_binding_dir}/configure-receipt.json" ${_biglybtc_role_arguments}
    RESULT_VARIABLE _biglybtc_binding_result)
  if(NOT _biglybtc_binding_result EQUAL 0)
    message(FATAL_ERROR "Persistent runtime/source manifest admission failed")
  endif()
  find_package(OpenSSL REQUIRED COMPONENTS Crypto)
  target_link_libraries(biglybtc_local_engine PRIVATE OpenSSL::Crypto ${CMAKE_DL_LIBS})
endif()
target_sources(biglybtc_local_engine PRIVATE persistent_runtime_guard.cpp)
target_include_directories(biglybtc_local_engine PRIVATE "${_biglybtc_binding_dir}")
