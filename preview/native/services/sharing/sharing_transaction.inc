};
std::string encodedPolicy(const detail::SharePolicy& p){return dictionary({{"announce",enc(p.announce)},{"comment",enc(p.comment)},{"conversions",enc(p.conversions)},{"ignore",enc(p.ignore)},{"extra",p.extraHashes?"i1e":"i0e"},{"dht",p.dhtBackup?"i1e":"i0e"}});}
std::string encodeIntent(const Intent& x){
 const auto u=[](std::uint64_t n){return enc(std::to_string(n));};
 return dictionary({{"schema",enc("BiglyBTC.ShareTransaction.V1")},{"op",enc(x.op)},{"source",enc(x.source)},{"before",enc(x.before)},{"beforePresent",x.beforePresent?"i1e":"i0e"},{"backup",enc(x.backup)},{"backupPresent",x.backupPresent?"i1e":"i0e"},{"after",enc(x.after)},{"cache",enc(x.cache)},{"data",enc(x.data)},{"fingerprint",enc(x.fingerprint)},{"policy",enc(x.policy)},{"phase","i"+std::to_string(x.phase)+"e"},{"kind","i"+std::to_string(x.kind)+"e"},{"request",u(x.request)},{"stageDev",u(x.stageDev)},{"stageIno",u(x.stageIno)},{"fileDev",u(x.fileDev)},{"fileIno",u(x.fileIno)},{"sharesDev",u(x.sharesDev)},{"sharesIno",u(x.sharesIno)},{"cacheDev",u(x.cacheDev)},{"cacheIno",u(x.cacheIno)}});
}
