// Closed profile-local transaction for one sharing row/cache operation.
// This is private storage code, not a serialized grant or arbitrary publisher.
constexpr auto IntentName="BiglyBTC.sharing-intent";
constexpr auto StageName=".BiglyBTC-sharing-create";
constexpr std::size_t IntentLimit=96*1024*1024;
std::string enc(std::string_view s){return std::to_string(s.size())+":"+std::string(s);}
std::string dictionary(const std::map<std::string,std::string>& values){std::string out="d";for(const auto& [key,value]:values){out+=enc(key)+value;}return out+'e';}
struct Intent {
 std::string op,source,before,backup,after,cache,data,fingerprint,policy;
 bool beforePresent=false,backupPresent=false;unsigned phase=0,kind=1;
