bool OwnedPingTransport::keyBlockForwardAlive(const std::shared_ptr<KeyBlockForward>& job)const noexcept{return owner()&&state_==State::Bound&&keyBlockForward_==job&&keyBlockForwardFacts_.active&&normalKeyBlocks_&&Clock::now()<job->end;}
KeyBlockMaintenanceFacts OwnedPingTransport::keyBlockMaintenanceFacts()const noexcept{return owner()?keyBlockForwardFacts_:KeyBlockMaintenanceFacts{};}
bool OwnedPingTransport::cancelKeyBlockForwarding(std::uint64_t operation){if(!owner()||!keyBlockForwardFacts_.active||keyBlockForwardFacts_.operation!=operation){return false;}finishKeyBlockForwarding(Failure::Cancelled);return true;}
void OwnedPingTransport::finishKeyBlockForwarding(std::optional<Failure> failure){keyBlockForwardDeadline_.stop();auto job=std::move(keyBlockForward_);if(!job){return;}keyBlockForwardFacts_.active=false;keyBlockForwardFacts_.failure=failure;for(auto& target:job->targets){if(target.ticket.value){cancel(target.ticket);}}job->records.clear();job->targets.clear();}
std::expected<std::uint64_t,Failure> OwnedPingTransport::republishKeyBlocks(std::chrono::milliseconds duration){
 if(!owner()){return std::unexpected(Failure::Thread);}if(!normalCurrent()||!normalSeeded_||!normalKeyBlocks_||!normalPreflight_||!normalRouter_||!dynamicRoutingScope(config_.routingScope)){return std::unexpected(Failure::Authority);}if(duration<=std::chrono::milliseconds::zero()||duration>std::chrono::minutes(30)){return std::unexpected(Failure::Deadline);}if(keyBlockForward_||keyBlockForwardFacts_.operation==UINT64_MAX){return std::unexpected(Failure::Capacity);}
 try{auto job=std::make_shared<KeyBlockForward>();job->records=normalKeyBlocks_->records(true);job->end=Clock::now()+duration;if(keyBlockForwardCursor_){const auto first=std::upper_bound(job->records.begin(),job->records.end(),*keyBlockForwardCursor_,[](const auto& key,const auto& record){return key<record.key();});std::rotate(job->records.begin(),first,job->records.end());}const auto operation=keyBlockForwardFacts_.operation+1;keyBlockForwardFacts_={};keyBlockForwardFacts_.operation=operation;keyBlockForwardFacts_.active=true;keyBlockForward_=job;keyBlockForwardDeadline_.start();pumpKeyBlockForwarding(job);return operation;}catch(...){finishKeyBlockForwarding(Failure::Capacity);return std::unexpected(Failure::Capacity);}
}
void OwnedPingTransport::tickKeyBlockForwarding(){if(!keyBlockForward_){keyBlockForwardDeadline_.stop();return;}auto job=keyBlockForward_;if(!keyBlockForwardAlive(job)){finishKeyBlockForwarding(Failure::Timeout);return;}for(const auto& target:job->targets){if(target.gating&&Clock::now()>=target.phaseEnd){finishKeyBlockForwarding(Failure::Timeout);return;}}try{pumpKeyBlockForwarding(job);}catch(...){finishKeyBlockForwarding(Failure::Capacity);}}
void OwnedPingTransport::pumpKeyBlockForwarding(const std::shared_ptr<KeyBlockForward>& job){
 if(!keyBlockForwardAlive(job)){return;}
 if(!job->loaded){
  for(unsigned scanned=0;job->next<job->records.size()&&scanned<64;++scanned){const auto& record=job->records[job->next];++keyBlockForwardFacts_.considered;const auto* current=normalKeyBlocks_->find(record.key());if(!current||*current!=record||!record.direct||record.key().size()!=20){keyBlockForwardCursor_=std::string(record.key());++job->next;continue;}find::nodes::NodeId key;std::copy_n(reinterpret_cast<const std::uint8_t*>(record.key().data()),20,key.begin());auto router=normalRouter_->snapshot();if(!router||router->limited()||router->config().k>64){finishKeyBlockForwarding(Failure::State);return;}auto closest=normalRouter_->closest(key,router->config().k,false);if(!closest){finishKeyBlockForwarding(Failure::State);return;}
   std::ranges::sort(std::span(closest->values).first(closest->count),[&](const auto& a,const auto& b){for(std::size_t i=0;i<20;++i){const auto x=a.id[i]^key[i],y=b.id[i]^key[i];if(x!=y){return x<y;}}return false;});const auto count=std::min<std::size_t>(closest->count,router->config().k);bool local=false;for(std::size_t i=0;i<count;++i){local|=closest->values[i].local;}if(local){for(std::size_t i=0;i<count;++i){const auto& node=closest->values[i];if(node.local){continue;}auto at=std::ranges::find(normalContacts_,node.id,&find::nodes::Contact::id);if(at==normalContacts_.end()||at->protocol<14||normalKeyBlocks_->hasSent(record.key(),std::string_view(reinterpret_cast<const char*>(node.id.data()),20))){continue;}auto peer=routingPeer(*at);if(peer){job->targets.push_back({*at,*peer,{},{},{},0,false,false,false});}}}
   if(job->targets.empty()){keyBlockForwardCursor_=std::string(record.key());++job->next;continue;}job->loaded=true;break;
  }if(!job->loaded){if(job->next==job->records.size()){finishKeyBlockForwarding();}return;}
 }
 unsigned active=0;for(std::size_t i=0;i<job->targets.size();++i){auto& target=job->targets[i];if(target.done){continue;}if(active++==3){break;}if(!target.gating&&!target.waiting){keyBlockForwardStep(job,i);}if(!keyBlockForwardAlive(job)){return;}}
 if(std::ranges::all_of(job->targets,[](const auto& target){return target.done;})){keyBlockForwardCursor_=std::string(job->records[job->next].key());++job->next;job->targets.clear();job->loaded=false;}
}
void OwnedPingTransport::keyBlockForwardPermit(const std::shared_ptr<KeyBlockForward>& job,std::size_t index,std::move_only_function<void()> next){
 if(!keyBlockForwardAlive(job)||index>=job->targets.size()){return;}auto& target=job->targets[index];const auto serial=target.serial=++job->serial;target.gating=true;target.phaseEnd=std::min(job->end,Clock::now()+std::chrono::seconds(5));const auto end=target.phaseEnd;auto once=std::make_shared<std::atomic_bool>(false);QPointer<OwnedPingTransport> self(this);
 auto done=[self,job,index,serial,end,once,next=std::move(next)](bool accepted)mutable{if(once->exchange(true)||!self){return;}if(!self->owner()){QMetaObject::invokeMethod(self,[self,job]{if(self&&self->keyBlockForwardAlive(job)){self->finishKeyBlockForwarding(Failure::Authority);}},Qt::QueuedConnection);return;}if(!self->keyBlockForwardAlive(job)||index>=job->targets.size()||job->targets[index].serial!=serial){return;}job->targets[index].gating=false;if(!accepted||!self->normalCurrent()||Clock::now()>=end){self->finishKeyBlockForwarding(Failure::Authority);return;}try{next();}catch(...){if(self){self->finishKeyBlockForwarding(Failure::Capacity);}}};bool queued=false;try{queued=normalPreflight_(std::move(done));}catch(...){queued=false;}if(self&&!queued&&!once->load()&&keyBlockForwardAlive(job)){finishKeyBlockForwarding(Failure::Capacity);}
}
void OwnedPingTransport::keyBlockForwardStep(const std::shared_ptr<KeyBlockForward>& job,std::size_t index){
 keyBlockForwardPermit(job,index,[this,job,index]{
  if(!keyBlockForwardAlive(job)||index>=job->targets.size()||job->next>=job->records.size()){return;}auto& target=job->targets[index];const auto& record=job->records[job->next];const auto* current=normalKeyBlocks_->find(record.key());if(!current||*current!=record){target.done=true;return;}auto actual=std::ranges::find(normalContacts_,target.contact.id,&find::nodes::Contact::id);if(actual==normalContacts_.end()){target.done=true;return;}const auto nowPeer=routingPeer(*actual);if(!nowPeer||*nowPeer!=target.peer){target.done=true;return;}if(actual->instance!=target.contact.instance||actual->protocol!=target.contact.protocol){target.contact=*actual;target.token.reset();}
  const auto serial=target.serial;target.waiting=true;const auto timeout=std::min(job->end-Clock::now(),Clock::duration(std::chrono::seconds(5)));QPointer<OwnedPingTransport> self(this);
  if(!target.token){auto sent=requestStoreToken(target.peer,target.contact.protocol,this,[self,job,index,serial](auto reply){if(!self||!self->keyBlockForwardAlive(job)||index>=job->targets.size()||job->targets[index].serial!=serial){return;}auto& target=job->targets[index];target.waiting=false;target.ticket={};const auto* decoded=reply?std::get_if<find::Decoded>(&*reply):nullptr;if(!decoded){target.done=true;++self->keyBlockForwardFacts_.failed;return;}target.token=std::get<find::ReplyBody>(decoded->body()).randomId;target.contact.instance=decoded->header().fields().instance;target.contact.protocol=decoded->header().fields().version;},timeout);if(sent){target.ticket=*sent;++keyBlockForwardFacts_.tokens;}else{target.waiting=false;target.done=true;++keyBlockForwardFacts_.failed;}return;}
  auto sent=sendKeyBlock(target.peer,target.contact.protocol,{*target.token,record.request,record.signature},this,[self,job,index,serial](const KeyBlockOutcome& reply){if(!self||!self->keyBlockForwardAlive(job)||index>=job->targets.size()||job->targets[index].serial!=serial){return;}auto& target=job->targets[index];target.waiting=false;target.ticket={};if(!reply||!std::get_if<keyblock::Decoded>(&*reply)){target.done=true;++self->keyBlockForwardFacts_.failed;return;}self->keyBlockForwardPermit(job,index,[self,job,index]{if(!self||!self->keyBlockForwardAlive(job)||index>=job->targets.size()){return;}auto& target=job->targets[index];const auto& record=job->records[job->next];const auto* current=self->normalKeyBlocks_->find(record.key());if(current&&*current==record&&self->normalKeyBlocks_->markSent(record.key(),std::string_view(reinterpret_cast<const char*>(target.contact.id.data()),20))){++self->keyBlockForwardFacts_.acknowledged;}target.done=true;});},timeout);if(sent){target.ticket=*sent;++keyBlockForwardFacts_.packets;}else{target.waiting=false;target.done=true;++keyBlockForwardFacts_.failed;}
 });
}
