// Direct signed blocks follow the existing cache-maintenance cadence.
struct OwnedPingTransport::KeyBlockForward {
 struct Target {find::nodes::Contact contact;Peer peer;Ticket ticket;std::optional<std::int32_t> token;Clock::time_point phaseEnd{};std::uint64_t serial=0;bool gating=false,waiting=false,done=false;};
