// Included in biglybtc::ui. Filters are observational; writes use the profile worker.
void LibraryWindow::updateTagStrips(){
 const auto data=tagStripData_&&(!columnSession_||tagStripData_->session==columnSession_)?tagStripData_:TagStripPresentation{};
 for(std::size_t i=0;i<tagStrips_.size();++i){auto* strip=tagStrips_[i];if(!strip){continue;}strip->setSnapshot(data,tagStripSettings_,tagStripFailure_);strip->setWritable(columnSession_&&!busy_&&!closing_&&!offlinePreview_&&!pendingTagStripSettings_&&!pendingTagChipAssignment_);auto* table=i?completeTable_:incompleteTable_;static_cast<ClassicFilter*>(table->model())->setTags(data,strip->selection().selected(),tagStripSettings_.inclusive);}
 incompleteCount_->setToolTip(tagStripFailure_.toHtmlEscaped());completeCount_->setToolTip(tagStripFailure_.toHtmlEscaped());
}
void LibraryWindow::requestTagStripSettings(TagStripSettings expected,TagStripSettings value){
 if(!columnSession_||busy_||closing_||offlinePreview_||pendingTagStripSettings_||pendingTagChipAssignment_||expected!=tagStripSettings_||tagStripRequest_==std::numeric_limits<quint64>::max()){return;}TagStripSettingsCommand command{columnSession_,++tagStripRequest_,expected,value};pendingTagStripSettings_=command;for(auto* strip:tagStrips_){strip->setWritable(false);}emit tagStripSettingsRequested(command);
}
void LibraryWindow::rejectTagStripSettings(const TagStripSettingsCommand& command){setTagStripSettingsResult({command.session,command.request,command.expected,tr("Library filter settings could not be queued")});}
void LibraryWindow::setTagStripSettingsResult(TagStripSettingsResult result){
 if(!pendingTagStripSettings_||result.session!=columnSession_||result.session!=pendingTagStripSettings_->session||result.request!=pendingTagStripSettings_->request){return;}const auto command=*pendingTagStripSettings_;if(result.failure.isEmpty()&&result.value!=command.value){return;}pendingTagStripSettings_.reset();if(closing_){return;}const TableViewportGuard viewport(incompleteTable_,completeTable_);const auto hashes=selectedHashes();const QPointer<LibraryWindow> guard(this);updating_=true;if(result.failure.isEmpty()){tagStripSettings_=result.value;}updateTagStrips();if(!guard){return;}restoreSelection(hashes);updating_=false;selectionChanged();if(!guard){return;}if(!result.failure.isEmpty()){setMessage(result.failure.left(512));}else{updateCounts();}
}

void LibraryWindow::requestTagChipAssignment(QString key,QTableView* source,QByteArray hashes){
 if(!columnSession_||busy_||closing_||offlinePreview_||pendingTagChipAssignment_||pendingTagStripSettings_||!tagStripData_||tagStripData_->session!=columnSession_||(source!=incompleteTable_&&source!=completeTable_)||tagChipAssignmentRequest_==std::numeric_limits<quint64>::max()){return;}
 const auto found=tagStripData_->byKey.constFind(key);if(found==tagStripData_->byKey.cend()){return;}const auto& chip=tagStripData_->chips[*found];TagChipAssignmentCommand command;command.session=columnSession_;command.request=++tagChipAssignmentRequest_;
 if(chip.kind==TagChipKind::Manual){if(!chip.tagId||!chip.membershipKnown){setMessage(tr("This tag membership is unavailable"));return;}command.kind=TagChipAssignmentKind::Manual;command.tagId=chip.tagId;}else{command.kind=TagChipAssignmentKind::Category;if(chip.kind==TagChipKind::Category){command.category=chip.name;}}
 command.longPress=hashes.isEmpty();if(!command.longPress){const auto end=hashes.indexOf('\n');if(end<0||hashes.first(end)!="session:"+QByteArray::number(columnSession_)){return;}hashes.remove(0,end+1);}if(command.longPress){for(const auto& row:source->selectionModel()->selectedRows()){hashes+=row.data(LibraryModel::HashRole).toString().toLatin1();hashes+='\n';}}
 if(hashes.size()>7*1024*1024){return;}QSet<QString> seen;for(const auto& encoded:hashes.split('\n')){if(encoded.isEmpty()){continue;}const auto hash=QString::fromLatin1(encoded).toLower();const auto row=model_->rowFor(hash);const auto target=model_->targetAt(row);if(!target||target->hash.compare(hash,Qt::CaseInsensitive)!=0||seen.contains(hash)||command.targets.size()>=LibraryModel::MaximumRows){return;}seen.insert(hash);command.targets.push_back(*target);}
 if(command.targets.empty()){setMessage(tr("Select torrents to assign this category or tag"));return;}pendingTagChipAssignment_=command;for(auto* strip:tagStrips_){strip->setWritable(false);}emit tagChipAssignmentRequested(std::move(command));
}
void LibraryWindow::rejectTagChipAssignment(const TagChipAssignmentCommand& command){setTagChipAssignmentResult({command.session,command.request,command.targets.size(),0,0,false,tr("Library assignment could not be queued")});}
void LibraryWindow::setTagChipAssignmentResult(TagChipAssignmentResult result){
 if(!pendingTagChipAssignment_||result.session!=columnSession_||result.session!=pendingTagChipAssignment_->session||result.request!=pendingTagChipAssignment_->request||result.total!=pendingTagChipAssignment_->targets.size()||result.applied>result.total||result.changed>result.applied||result.failure.size()>8192){return;}pendingTagChipAssignment_.reset();if(closing_){return;}const QPointer<LibraryWindow> guard(this);updateActions();if(!guard){return;}if(result.failure.isEmpty()){setMessage(tr("Updated %1 of %2 torrents").arg(result.changed).arg(result.total));}else{setMessage(tr("Library assignment stopped after %1 of %2 torrents: %3").arg(result.applied).arg(result.total).arg(result.failure.left(512)));}
}
