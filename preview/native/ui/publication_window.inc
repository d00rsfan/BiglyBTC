PublicationControls* LibraryWindow::publicationControls(PublicationKind kind)const{return kind==PublicationKind::Shares?sharingControls_.data():trackerControls_.data();}
void LibraryWindow::installPublicationControls(PublicationKind kind,SavedServicePage* page){
 if(!page){return;}auto* value=new PublicationControls(kind,&page->table(),page);page->installOwnedControls(value);if(kind==PublicationKind::Shares){sharingControls_=value;}else{trackerControls_=value;}QPointer<PublicationControls> controls=value;controls->beginSession(columnSession_,reserveRssUiIdentity());controls->setAvailable(!busy_&&!closing_,offlinePreview_);
 connect(controls,&PublicationControls::catalogRequested,this,[this,controls](PublicationCatalogKey key){if(!controls||controls!=publicationControls(key.kind)||closing_||busy_||key.session!=columnSession_){if(controls){controls->refuseCatalog(key);}return;}key.request=reserveRssUiIdentity();if(!key.request){controls->refuseCatalog(key);return;}QPointer<LibraryWindow> alive(this);controls->setCatalogPending(key);if(!alive||!controls||controls!=publicationControls(key.kind)){return;}auto* view=key.kind==PublicationKind::Shares?static_cast<SavedServicePage*>(sharesPage_.data()):static_cast<SavedServicePage*>(hostingPage_.data());if(view){view->beginRequest(key.request);}if(alive&&controls&&key.session==columnSession_){emit publicationCatalogRequested(key);}});
 connect(controls,&PublicationControls::commandRequested,this,[this,controls](PublicationCommand command){if(!controls||controls!=publicationControls(command.key.kind)||closing_||busy_||offlinePreview_||command.key.session!=columnSession_){if(command.receiver){command.receiver->request_stop();}if(controls){controls->refuse(command);}return;}command.key.request=reserveRssUiIdentity();if(!command.key.request){if(command.receiver){command.receiver->request_stop();}controls->refuse(command);return;}QPointer<LibraryWindow> alive(this);controls->setPending(command);if(alive&&controls&&controls==publicationControls(command.key.kind)&&!command.receiver->stop_requested()){emit publicationRequested(std::move(command));}});
 connect(controls,&PublicationControls::cancelRequested,this,[this](PublicationCommandKey key){QPointer<LibraryWindow> alive(this);if(publicationReview_&&publicationReview_->frame()&&publicationReview_->frame()->key==key){publicationReview_->invalidate();if(!alive){return;}}emit publicationCancelRequested(key);});
}
void LibraryWindow::refreshPublicationViews(){if(closing_){return;}if(onSavedServicePage()){if(mainTabs_->currentWidget()==sharesPage_&&sharingControls_){sharingControls_->refresh();}else if(mainTabs_->currentWidget()==hostingPage_&&trackerControls_){trackerControls_->refresh();}}}
void LibraryWindow::setPublicationCatalog(PublicationCatalogPresentation packet){
 if(!packet||closing_||packet->key.session!=columnSession_){return;}QPointer<LibraryWindow> alive(this);QPointer<PublicationControls> controls=publicationControls(packet->key.kind);if(!controls||controls->page()!=packet->key.page){return;}
 const auto source=[&]{switch(packet->source.value_or(PublicationSource::Primary)){case PublicationSource::Backup:return SavedPageSource::Backup;case PublicationSource::Saving:return SavedPageSource::Saving;default:return SavedPageSource::Primary;}};
 if(packet->key.kind==PublicationKind::Shares&&sharesPage_){if(packet->shares&&packet->source){sharesPage_->setReady(packet->key.request,packet->shares,source());}else if(packet->warning.isEmpty()){sharesPage_->setMissing(packet->key.request);}else{sharesPage_->setFailed(packet->key.request,packet->warning);}}
 else if(packet->key.kind==PublicationKind::Tracker&&hostingPage_){if(packet->hosting&&packet->source){hostingPage_->setReady(packet->key.request,packet->hosting,source());}else if(packet->warning.isEmpty()){hostingPage_->setMissing(packet->key.request);}else{hostingPage_->setFailed(packet->key.request,packet->warning);}}
 if(alive&&controls&&controls==publicationControls(packet->key.kind)&&controls->session()==packet->key.session&&controls->page()==packet->key.page){controls->setCatalog(packet);}
}
void LibraryWindow::setPublicationResult(PublicationPresentation packet){
 if(!packet||closing_||packet->key.session!=columnSession_){return;}QPointer<LibraryWindow> alive(this);QPointer<PublicationControls> controls=publicationControls(packet->key.kind);if(!controls||!controls->owns(packet->key)){return;}controls->setResult(packet);if(!alive||!controls||controls!=publicationControls(packet->key.kind)){return;}
 if(packet->state==PublicationState::ReviewReady&&packet->review&&controls->owns(packet->key,true)){
  if(!publicationReview_){publicationReview_=new PublicationReviewDialog(this);connect(publicationReview_,&PublicationReviewDialog::confirmed,this,[this](PublicationConfirmation command){auto* c=publicationControls(command.key.kind);const auto frame=publicationReview_?publicationReview_->frame():PublicationPresentation{};if(closing_||busy_||offlinePreview_||!c||!c->owns(command.key,true)||!frame||frame->key!=command.key||!frame->review||frame->review->revision!=command.revision){return;}emit publicationConfirmed(command);});connect(publicationReview_,&PublicationReviewDialog::cancelled,this,[this](PublicationCommandKey key){emit publicationCancelRequested(key);});}
  const auto dialog=publicationReview_;if(dialog->beginReview(packet)&&alive&&dialog&&controls&&controls->owns(packet->key,true)){dialog->open();}
 }else if(packet->state!=PublicationState::Started){
  if(publicationReview_&&publicationReview_->frame()&&publicationReview_->frame()->key==packet->key){if(packet->state==PublicationState::Completed){publicationReview_->complete();}else{publicationReview_->invalidate();}if(!alive){return;}}
  if(packet->committed||packet->state==PublicationState::Completed){for(const auto& c:{sharingControls_,trackerControls_}){if(c){c->refresh();if(!alive){return;}}}}
 }
}
void LibraryWindow::rejectPublicationCatalog(PublicationCatalogKey key){if(auto* controls=publicationControls(key.kind)){controls->refuseCatalog(key);}}
void LibraryWindow::rejectPublication(const PublicationCommand& command){if(auto* controls=publicationControls(command.key.kind)){controls->refuse(command);}}

void LibraryWindow::rejectPublicationConfirmation(PublicationConfirmation command){const auto frame=publicationReview_?publicationReview_->frame():PublicationPresentation{};auto* controls=publicationControls(command.key.kind);if(frame&&frame->key==command.key&&frame->review&&frame->review->revision==command.revision&&controls&&controls->owns(command.key,true)){publicationReview_->beginReview(frame);}}
