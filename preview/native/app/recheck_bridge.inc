bool sameRecheckIntent(const core::SavedDownload& a,const core::SavedDownload& b){return a.hash==b.hash&&a.torrentFile==b.torrentFile&&a.saveDirectory==b.saveDirectory&&a.saveFile==b.saveFile&&a.legacySavePath==b.legacySavePath&&a.persistent==b.persistent&&a.originalState==b.originalState&&a.startup==b.startup&&a.forceStart==b.forceStart;}
bool sameRecheckPause(const std::optional<core::SavedPause>& a,const std::optional<core::SavedPause>& b){return a.has_value()==b.has_value()&&(!a||(a->hash==b->hash&&a->forceStart==b->forceStart&&a->owner==b->owner));}
}
void SessionBridge::stopRecheckReceiver()noexcept{if(guiRecheck_&&guiRecheck_->receiver){guiRecheck_->receiver->request_stop();}}
void SessionBridge::cancelRecheck(ui::RecheckKey key){if(guiRecheck_&&guiRecheck_->key==key){stopRecheckReceiver();}}
void SessionBridge::deliverRecheck(ui::RecheckPresentation packet){if(!packet||profileClosed_||packet->key.session!=publishedColumnLayoutSession_||!guiRecheck_||guiRecheck_->key!=packet->key||packet->sequence<=guiRecheckSequence_){return;}guiRecheckSequence_=packet->sequence;if(packet->terminal){guiRecheck_.reset();}emit recheckReady(std::move(packet));}
