function(biglybtc_add_profile_preflight profile_target with_tests)
  set(sources "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
  add_library(biglybtc_profile_preflight STATIC "${sources}/profile_preflight.cpp")
  target_include_directories(biglybtc_profile_preflight PUBLIC "${sources}")
  target_link_libraries(biglybtc_profile_preflight PUBLIC ${profile_target})

  add_executable(biglybtc-profile-check "${sources}/profile_preflight_main.cpp")
  target_link_libraries(biglybtc-profile-check PRIVATE biglybtc_profile_preflight)
  if(MINGW)
    target_link_options(biglybtc-profile-check PRIVATE -municode)
  endif()

  set(targets biglybtc_profile_preflight biglybtc-profile-check)
  if(with_tests)
    add_executable(biglybtc-profile-preflight-tests "${sources}/../tests/profile_preflight_tests.cpp")
    target_link_libraries(biglybtc-profile-preflight-tests PRIVATE biglybtc_profile_preflight)
    add_test(NAME readonly-profile-preflight COMMAND biglybtc-profile-preflight-tests)
    set_tests_properties(readonly-profile-preflight PROPERTIES TIMEOUT 30 LABELS "profile;read-only")
    list(APPEND targets biglybtc-profile-preflight-tests)
  endif()
  foreach(target IN LISTS targets)
    if(MSVC)
      target_compile_options(${target} PRIVATE /utf-8 /Zc:__cplusplus)
    else()
      target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror)
    endif()
  endforeach()
endfunction()
