// Private pure encodings/closed A-R-F derivation; never a storage authority.
constexpr std::size_t AcquisitionBytes=192*1024*1024;
constexpr std::string_view OwnerName="BiglyBTC.subscription-acquire";
struct AcquisitionFailure {storage::Error error;};
[[noreturn]] void fail(storage::ErrorCode code,const char* message){throw AcquisitionFailure{{code,message}};}
void require(bool value,storage::ErrorCode code,const char* message){if(!value){fail(code,message);}}
template<class T>T take(std::expected<T,storage::Error> value){if(!value){throw AcquisitionFailure{value.error()};}return std::move(*value);}
void take(std::expected<void,storage::Error> value){if(!value){throw AcquisitionFailure{value.error()};}}
std::string stringValue(std::string_view value){return std::to_string(value.size())+":"+std::string(value);}
std::string integerValue(std::int64_t value){return "i"+std::to_string(value)+"e";}
std::string dictionaryValue(const std::map<std::string,std::string>& fields){std::string out="d";for(const auto& [key,value]:fields){out+=stringValue(key)+value;}return out+"e";}
bool uniqueValue(const core::Node& node){if(node.type==core::Node::Type::Dictionary){std::set<std::string_view> keys;for(std::size_t i=0;i<node.children.size();i+=2){if(!keys.insert(node.children[i].bytes).second){return false;}}}return std::ranges::all_of(node.children,[](const auto& child){return uniqueValue(child);});}
core::Document document(std::string bytes,std::size_t cap=AcquisitionBytes){auto value=core::Document::parse(std::move(bytes),{cap,cap,500000,64});require(value&&value->root().type==core::Node::Type::Dictionary&&uniqueValue(value->root()),storage::ErrorCode::InvalidFormat,"Malformed bounded acquisition data");return std::move(*value);}
std::string field(const core::Node& node,std::string_view name){const auto* value=node.find(name);require(value&&value->type==core::Node::Type::Bytes,storage::ErrorCode::InvalidFormat,"Acquisition field missing or malformed");return std::string(value->bytes);}
std::int64_t integer(const core::Node& node,std::string_view name){const auto* value=node.find(name);require(value&&value->type==core::Node::Type::Integer,storage::ErrorCode::InvalidFormat,"Acquisition integer missing");return value->integer;}
std::optional<std::string> optionalField(const core::Node& node,std::string_view name){const auto* value=node.find(name);require(value,storage::ErrorCode::InvalidFormat,"Acquisition optional field missing");if(value->type==core::Node::Type::Bytes){return std::string(value->bytes);}require(value->type==core::Node::Type::Integer&&value->integer==0,storage::ErrorCode::InvalidFormat,"Acquisition optional field malformed");return {};}
std::string encodedOptional(const std::optional<std::string>& value){return value?stringValue(*value):"i0e";}
std::string scope(const struct stat& value){return std::to_string(value.st_dev)+":"+std::to_string(value.st_ino)+":"+std::to_string(value.st_uid);}
std::string stamp(const struct stat& f){return std::to_string(f.st_dev)+":"+std::to_string(f.st_ino)+":"+std::to_string(f.st_mode)+":"+std::to_string(f.st_uid)+":"+std::to_string(f.st_gid)+":"+std::to_string(f.st_nlink)+":"+std::to_string(f.st_size)+":"+std::to_string(f.st_mtim.tv_sec)+":"+std::to_string(f.st_mtim.tv_nsec)+":"+std::to_string(f.st_ctim.tv_sec)+":"+std::to_string(f.st_ctim.tv_nsec);}
std::string digest(std::string_view bytes){return QCryptographicHash::hash(QByteArrayView(bytes.data(),static_cast<qsizetype>(bytes.size())),QCryptographicHash::Sha256).toHex().toStdString();}
std::string hex(std::string_view raw){return QByteArray(raw.data(),static_cast<qsizetype>(raw.size())).toHex().toUpper().toStdString();}
std::string selectedBytes(const search::SavedSubscriptionResultSelector& selected){std::map<std::string,std::string> fields{{"index",integerValue(static_cast<std::int64_t>(selected.subscription.sourceIndex))},{"sid",stringValue(selected.subscription.shortId)},{"public_key",stringValue(selected.subscription.publicKey)},{"singleton",encodedOptional(selected.subscription.singletonKey)},{"version",integerValue(selected.subscription.version)},{"result",stringValue(selected.resultKey)}};return dictionaryValue(fields);}
search::SavedSubscriptionResultSelector selectedFrom(std::string bytes){auto root=document(std::move(bytes),65536);search::SavedSubscriptionResultSelector out;const auto index=integer(root.root(),"index");require(index>=0&&index<4096,storage::ErrorCode::InvalidFormat,"Acquisition index invalid");out.subscription={static_cast<std::size_t>(index),field(root.root(),"sid"),field(root.root(),"public_key"),optionalField(root.root(),"singleton"),integer(root.root(),"version")};out.resultKey=field(root.root(),"result");require(out.subscription.shortId.size()==10&&out.resultKey.size()==10&&!out.subscription.publicKey.empty()&&out.subscription.publicKey.size()<=4096&&out.subscription.version>0,storage::ErrorCode::InvalidFormat,"Acquisition identity invalid");return out;}
struct AssociationReadValues {std::string association,results,finalConfiguration;bool newAssociation=false;};
std::string applyAssociation(std::string configuration,std::size_t index,const std::string& list){auto root=document(std::move(configuration),4*1024*1024);const auto* rows=root.find("subs");require(rows&&rows->type==core::Node::Type::List&&index<rows->children.size(),storage::ErrorCode::InvalidFormat,"Acquisition subscription list changed");const auto& selected=rows->children[index];auto row=document(root.originalBytes().substr(selected.begin,selected.end-selected.begin),4*1024*1024);require(bool(row.replaceValue("assoc",list)),storage::ErrorCode::InvalidFormat,"Cannot prepare association values");std::string values="l";for(std::size_t i=0;i<rows->children.size();++i){const auto& value=rows->children[i];values+=i==index?row.serialize():root.originalBytes().substr(value.begin,value.end-value.begin);}values+='e';require(bool(root.replaceValue("subs",values)),storage::ErrorCode::InvalidFormat,"Cannot prepare subscription values");return root.serialize();}
AssociationReadValues associationRead(std::string configuration,std::string results,const search::SavedSubscriptionResultSelector& selected,const core::TorrentHash& hash,std::int64_t when,search::SubscriptionIndexPurpose purpose=search::SubscriptionIndexPurpose::Manual){auto index=search::parseSubscriptionIndex(configuration,purpose);auto prior=search::parseSubscriptionResults(std::move(results));require(index&&prior&&selected.subscription.sourceIndex<index->rows.size()&&index->rows[selected.subscription.sourceIndex].selected==selected.subscription&&!index->rows[selected.subscription.sourceIndex].issue&&hash.bytes().size()==20,storage::ErrorCode::InvalidFormat,"Acquisition before values invalid");const auto found=std::ranges::find(prior->rows,selected.resultKey,&search::SubscriptionResultValue::key);require(found!=prior->rows.end()&&!found->read&&!found->deleted,storage::ErrorCode::Conflict,"Acquisition result no longer unread");const auto* rows=index->source->find("subs");const auto& selectedRow=rows->children[selected.subscription.sourceIndex];auto associations=search::detail::parseSubscriptionAssociations(index->source->originalBytes().substr(selectedRow.begin,selectedRow.end-selectedRow.begin));require(bool(associations),storage::ErrorCode::InvalidFormat,"Association values malformed");search::detail::SubscriptionAssociationHash full{};std::copy(hash.bytes().begin(),hash.bytes().end(),full.begin());auto added=search::detail::planSubscriptionAssociationValue(*associations,full,when);require(bool(added),storage::ErrorCode::Unsupported,"Association eviction is unsupported");auto read=search::changeSubscriptionResultState(*index,selected.subscription.sourceIndex,*prior,{selected.resultKey},true,false,when);require(bool(read),storage::ErrorCode::Conflict,"Cannot prepare result read values");return {applyAssociation(configuration,selected.subscription.sourceIndex,added->encodedList),std::move(read->results),applyAssociation(std::move(read->configuration),selected.subscription.sourceIndex,added->encodedList),added->changed};}

bool associationIsNew(std::string configuration,const search::SavedSubscriptionResultSelector& selected,const core::TorrentHash& hash,search::SubscriptionIndexPurpose purpose=search::SubscriptionIndexPurpose::Manual){auto index=search::parseSubscriptionIndex(std::move(configuration),purpose);require(index&&selected.subscription.sourceIndex<index->rows.size()&&index->rows[selected.subscription.sourceIndex].selected==selected.subscription&&hash.bytes().size()==20,storage::ErrorCode::Conflict,"Acquisition association source invalid");const auto* rows=index->source->find("subs");const auto& row=rows->children[selected.subscription.sourceIndex];auto values=search::detail::parseSubscriptionAssociations(index->source->originalBytes().substr(row.begin,row.end-row.begin));require(bool(values),storage::ErrorCode::InvalidFormat,"Acquisition association values malformed");search::detail::SubscriptionAssociationHash actual{};std::copy(hash.bytes().begin(),hash.bytes().end(),actual.begin());const auto capacity=search::detail::subscriptionAssociationCapacity(*values,actual);require(capacity!=search::detail::SubscriptionAssociationCapacity::OriginalRandomEvictionRequired,storage::ErrorCode::Unsupported,"Association eviction is unsupported");return capacity!=search::detail::SubscriptionAssociationCapacity::AlreadyPresent;}
