# Run only after building the reviewed azlocprov target, before compiling app.
if(NOT DEFINED INPUT OR NOT IS_ABSOLUTE "${INPUT}" OR NOT EXISTS "${INPUT}" OR IS_SYMLINK "${INPUT}")
  message(FATAL_ERROR "Country approval needs the actual built regular module")
endif()
if(NOT DEFINED OUTPUT OR NOT DEFINED VERSION OR NOT VERSION MATCHES "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(\\.[0-9]+)?$")
  message(FATAL_ERROR "Country approval needs output and exact native version")
endif()
file(SIZE "${INPUT}" MODULE_BYTES)
if(MODULE_BYTES LESS 1 OR MODULE_BYTES GREATER 67108864)
  message(FATAL_ERROR "Country module exceeds approved bounded size")
endif()
file(SHA256 "${INPUT}" MODULE_SHA256)
get_filename_component(OUTPUT_DIRECTORY "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/country_approval.hpp.in" "${OUTPUT}" @ONLY)
