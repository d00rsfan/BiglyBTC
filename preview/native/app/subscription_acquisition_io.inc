bool extends(const Intent& before,const Intent& after){return before.source==after.source&&before.selection==after.selection&&before.plan==after.plan&&before.nonce==after.nonce&&before.tempDirectory==after.tempDirectory&&before.tempScope==after.tempScope&&before.tempHash==after.tempHash&&before.mode==after.mode&&before.destination==after.destination&&before.ownerSession==after.ownerSession&&before.targetHash==after.targetHash&&before.filenameConversions==after.filenameConversions&&before.decoderShowAll==after.decoderShowAll&&before.stateBaseSha256==after.stateBaseSha256&&before.newAssociation==after.newAssociation&&(!before.tempRetired||after.tempRetired)&&(!before.stopped||after.stopped)&&(!before.done||after.done)&&(!before.values||(after.values&&before.when==after.when&&before.values->association==after.values->association&&before.values->results==after.values->results&&before.values->finalConfiguration==after.values->finalConfiguration));}
