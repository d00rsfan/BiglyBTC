  if(file.primary==desired){file.saving.reset();append();return;}
  if(file.saving&&file.saving!=desired){file.saving.reset();append();}
  if(!file.saving){file.saving=desired;append();}
  file.primary=file.saving;file.saving.reset();append();
}
unsigned logicalCallbackProgress(int root,int child,int active,const std::string& resultName,const std::string& stateName,const std::string& beforeConfig,const std::optional<std::string>& configBackup,const std::string& beforeResults,const std::optional<std::string>& resultsBackup,std::string_view stateBase,std::string_view statePrepared,std::string_view stateAssociated,std::optional<std::string_view> stateBackup,const AssociationReadValues& values,bool existing,bool stopped,bool done){
  std::array<FileValue,3> configs{readFile(root,"subscriptions.config",4*1024*1024),readFile(root,"subscriptions.config.bak",4*1024*1024),readFile(root,"subscriptions.config.saving",4*1024*1024)};
  std::array<FileValue,3> results{readFile(child,resultName,4*1024*1024),readFile(child,resultName+".bak",4*1024*1024),readFile(child,resultName+".saving",4*1024*1024)};
  std::array<FileValue,3> state{readFile(active,stateName,16*1024*1024),readFile(active,stateName+".bak",16*1024*1024),readFile(active,stateName+".saving",16*1024*1024)};
  const auto family=[](const auto& files){const auto view=[](const auto& file)->std::optional<std::string_view>{return file.present?std::optional<std::string_view>{file.bytes}:std::nullopt;};return FamilyView{view(files[0]),view(files[1]),view(files[2])};};const CallbackFiles actual{{family(configs),family(results)},family(state)};
  CallbackFiles cursor{{{beforeConfig,optionalView(configBackup),{}},{beforeResults,optionalView(resultsBackup),{}}},{stateBase,stateBackup,{}}};std::vector<CallbackCut> forward{{cursor,0}};const auto actions=callbackActions(existing);
  for(unsigned n=0;n<actions.size();++n){const auto action=actions[n];const std::string_view desired=action==CallbackAction::PrepareCache?statePrepared:action==CallbackAction::DownloadState?stateAssociated:action==CallbackAction::Association?values.association:action==CallbackAction::Read?values.results:values.finalConfiguration;callbackWriterStates(cursor,action,desired,n,forward);forward.push_back({cursor,n+1});}
