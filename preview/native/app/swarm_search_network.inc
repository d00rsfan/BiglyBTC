}
void Owner::rcmPublishSearch(std::string status){
 if(!rcmSearch_){return;}auto out=std::make_shared<rcm::SearchProgress>();out->id=rcmSearch_->id;out->term=rcmSearch_->request.term;out->status=status.empty()?(rcmSearch_->running?"Searching Public DHT…":"Search finished"):std::move(status);out->running=rcmSearch_->running;out->contacts=rcmSearch_->attempted;out->active=rcmSearch_->flight.size();out->results.reserve(rcmSearch_->results.size());for(const auto& [key,item]:rcmSearch_->results){(void)key;out->results.push_back(item);}rcmSearchView_=std::move(out);changed();
}
void Owner::rcmStopSearch(std::string status){
 if(!rcmSearch_||!rcmSearch_->running){return;}auto work=rcmSearch_;work->running=false;work->pending.clear();work->flight.clear();for(const auto& [key,ticket]:work->tickets){(void)key;if(lanes_[ticket.first]&&lanes_[ticket.first]->actor){lanes_[ticket.first]->actor->cancelTransfer(ticket.second);}}work->tickets.clear();rcmPublishSearch(std::move(status));
}
void Owner::rcmAddSearchPeer(const std::shared_ptr<SearchWork>& work,SearchPeer candidate){
 if(!work||!work->running||candidate.lane>=3||work->seen.size()>=128||work->pending.size()>=100){return;}const auto peer=peerOf(candidate.contact);if(owned_?!peer.address.isLoopback():!publicAddress(peer)){return;}if(work->seen.insert(searchPeerKey(candidate.lane,peer)).second){work->pending.push_back(std::move(candidate));}
}
