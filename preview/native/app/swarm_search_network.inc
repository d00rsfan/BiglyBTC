 auto old=std::ranges::min_element(rcmForeign_,{},[](const auto& entry){return entry.second.updated;});if(old!=rcmForeign_.end()&&now-old->second.updated>=std::chrono::minutes(15)){rcm::SearchMessage message;message.operation=rcm::SearchOperation::UpdateBloom;message.bloomCount=std::int32_t(old->second.bloom.count());rcmSearchCall(old->second.peer,std::move(message),0,true);return;}
