 auto operation=std::make_shared<rcm::SearchMessage>(std::move(*message));
 rcmSearchGate(lane,std::min(request->deadline,now+std::chrono::seconds(10)),[this,lane,request,reply,operation]{if(!*reply||request->sourceRevision!=rcmSearchRevision(lane)){return;}if(operation->operation==rcm::SearchOperation::Query){auto query=rcm::SearchQuery::compile(operation->query);if(query){for(const auto& [key,foreign]:rcmForeign_){(void)key;auto hit=rcm::bloomMayMatch(foreign.bloom,*query);if(hit&&*hit&&(*reply)->contacts.size()<50){const auto peer=peerOf(foreign.peer.contact);(*reply)->contacts.push_back({peer.address.toString().toStdString(),peer.port});}}}}
  auto encoded=rcm::encodeSearchResponse(**reply);while(!encoded&&!(*reply)->items.empty()){(*reply)->items.pop_back();encoded=rcm::encodeSearchResponse(**reply);}if(encoded){static_cast<void>(lanes_[lane]->actor->answerTransfer(request->receipt,std::move(*encoded)));}
 },{},[profile,sources,reply,operation,values=std::move(*values),neighbour](std::stop_token stop)->Broker::Result{
