  if(operation->operation==rcm::SearchOperation::Query){response.resultsPresent=true;auto query=rcm::SearchQuery::compile(operation->query);if(!query){return std::unexpected(failure(storage::ErrorCode::InvalidFormat,"Invalid search term"));}auto items=(**sources).local;items.insert(items.end(),(**sources).dht.begin(),(**sources).dht.end());auto result=rcm::search(items,*query,true,QDateTime::currentMSecsSinceEpoch());if(!result){return std::unexpected(failure(storage::ErrorCode::InvalidFormat,"Search work budget exhausted"));}response.items=std::move(*result);}
  else{auto blooms=rcm::buildSearchBlooms((**sources).local,(**sources).dht,QRandomGenerator::system()->generate64());if(!blooms){return std::unexpected(failure(storage::ErrorCode::InvalidFormat,"Search Bloom work budget exhausted"));}auto bloom=neighbour?std::move(blooms->withoutDht):std::move(blooms->all);if(operation->operation==rcm::SearchOperation::UpdateBloom&&std::uint32_t(operation->bloomCount)==bloom.count()){response.unchangedCount=operation->bloomCount;}else{response.bloom=std::move(bloom);}}
