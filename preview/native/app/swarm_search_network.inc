  if(stop.stop_requested()||Clock::now()>=end){return std::unexpected(failure(storage::ErrorCode::Cancelled,"Search operation expired"));}auto valid=policy->validate();if(!valid){return std::unexpected(valid.error());}auto settings=profile->searchPermission();if(!settings){return std::unexpected(settings.error());}*options=*settings;if(!settings->enabled||(settings->useBigly?lane!=2:lane==2)){return std::unexpected(failure(storage::ErrorCode::Unsupported,"Public search no longer permitted"));}if(custom){return custom(stop);}return Broker::Data{};
 });
}
void Owner::rcmRegisterSearch(std::size_t lane){
 auto result=lanes_[lane]->actor->registerTransferHandler(rcm::searchHandler(lane==2),false,this,[this,lane](auto request){rcmReceiveSearch(lane,std::move(request));},[this,lane]{return rcmSearchRevision(lane);},udp::TransferMode::Read);if(!result){rcmFacts_.status="Public search handler is unavailable";changed();}
}
std::vector<Owner::SearchPeer> Owner::rcmSearchPeers()const{
 std::vector<SearchPeer> out;if(!swarmSnapshot_||!swarmSnapshot_->settings.enabled){return out;}
 for(std::size_t lane=0;lane<3;++lane){if(!lanes_[lane]||!lanes_[lane]->ready||(swarmSnapshot_->settings.useBigly?lane!=2:lane==2)){continue;}if(const auto route=lanes_[lane]->actor->routingSnapshot()){const auto start=route->contactCount?QRandomGenerator::system()->bounded(unsigned(route->contactCount)):0;for(std::size_t i=0;i<route->contactCount&&out.size()<100;++i){const auto& c=route->contacts[(start+i)%route->contactCount].contact;const auto peer=peerOf(c);if(c.id!=lanes_[lane]->local.id&&(owned_?peer.address.isLoopback():publicAddress(peer))){out.push_back({lane,c});}}}}
 return out;
}
