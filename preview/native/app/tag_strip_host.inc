// Host worker, within its actual held profile source access. Never opens active/*.dat.
void finishTagStrip(const std::shared_ptr<ui::LibraryPresentation>& result,const std::optional<core::SavedDownloadTags>& tags,QString failure,std::stop_token stop){
 checkpoint(stop);if(!tags){result->tagStripFailure=failure;return;}std::string categories="de";auto file=storage::ConfigFile::load(lease,"categories.config");if(file){categories=file->document().originalBytes();}else if(file.error().code!=storage::ErrorCode::Missing){result->tagStripFailure=SessionBridge::tr("Saved category filters are unavailable");return;}
 const auto& tagBytes=tags->source->originalBytes();if(tagStripCache&&tagStripCache->session==columnLayoutSession&&tagStripTagsBytes==tagBytes&&tagStripCategoryBytes==categories&&tagStripHashes==currentHashes){result->tagStrip=tagStripCache;return;}
 auto cats=core::readSavedCategories(categories);if(!cats){result->tagStripFailure=SessionBridge::tr("Saved category filters are unreadable");return;}std::vector<core::TorrentHash> hashes;hashes.reserve(currentHashes.size());for(const auto& key:currentHashes){const auto bytes=QByteArray::fromHex(QByteArray::fromStdString(key));auto hash=core::TorrentHash::parse(std::string_view(bytes.constData(),std::size_t(bytes.size())));if(!hash){result->tagStripFailure=SessionBridge::tr("Current library filters are unavailable");return;}hashes.push_back(*hash);}
 if(tagStripRevision==std::numeric_limits<quint64>::max()){result->tagStripFailure=SessionBridge::tr("Library filter revision exhausted");return;}auto data=ui::makeTagStripData(columnLayoutSession,result->revision,++tagStripRevision,*tags,*cats,hashes);if(!data){result->tagStripFailure=SessionBridge::tr("Saved library filters are unavailable");return;}tagStripTagsBytes=tagBytes;tagStripCategoryBytes=std::move(categories);tagStripHashes=currentHashes;tagStripCache=std::move(*data);result->tagStrip=tagStripCache;
}
